              "options": {
                "name": "patient_preview",
                "columnSpan": 4,
                "hidden": false,
                "content": "<el-card class=\"lab-patient-card\" shadow=\"never\"><div v-if=\"pid && (pid.hn || pid._id || pid.value)\" class=\"lab-patient-main\"><el-avatar shape=\"square\" :size=\"74\" fit=\"cover\" :src=\"pid.p_pic && pid.p_pic[0] && pid.p_pic[0].url\" class=\"lab-patient-avatar\"><svg viewBox=\"0 0 24 24\" class=\"lab-patient-avatar-placeholder\"><path d=\"M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4.4 0-8 2.7-8 6v2h16v-2c0-3.3-3.6-6-8-6z\"/></svg></el-avatar><div class=\"lab-patient-identity\"><div class=\"lab-patient-name-row\"><span class=\"lab-patient-name\">{{ (pid.prename && pid.prename.label) || '' }}{{ pid.p_fname || '' }} {{ pid.p_lname || '' }}</span><span class=\"lab-patient-chip primary\">HN {{ pid.hn || '-' }}</span><span class=\"lab-patient-chip\">อายุ {{ pid.age || '-' }} ปี</span><span class=\"lab-patient-chip\">{{ pid.p_gender === '1' ? 'ชาย' : pid.p_gender === '2' ? 'หญิง' : '-' }}</span><span class=\"lab-patient-chip\">หมู่เลือด {{ ({'1':'A','2':'B','3':'AB','4':'O','5':'ไม่ทราบ','9':'ไม่ทราบ'})[pid.p_abogroup] || pid.p_abogroup || '-' }}</span></div><div class=\"lab-patient-meta\">วันเกิด <b>{{ pid.birth_date || '-' }}</b><span class=\"lab-patient-sep\">·</span>โทร. <b>{{ pid.p_phone || '-' }}</b></div><div class=\"lab-rights\"><span class=\"lab-patient-chip success\">สิทธิหลัก: {{ (pid.inscl_main_code && pid.inscl_main_code.label) || '-' }}</span><span class=\"lab-patient-chip success\">สิทธิย่อย: {{ (pid.inscl_sub_code && pid.inscl_sub_code.label) || '-' }}</span></div></div></div><el-empty v-else :image-size=\"70\" description=\"เลือกผู้ป่วยเพื่อเริ่มสั่ง LAB\" /></el-card>",
                "customClass": "",
                "onCreated": "",
