  "formConfig": {
    "modelName": "formData",
    "refName": "sdForm",
    "rulesName": "rules",
    "labelWidth": 120,
    "labelPosition": "top",
    "size": "",
    "labelAlign": "label-right-align",
    "cssCode": ".lab-patient-card{margin-bottom:16px;border:1px solid var(--el-border-color);border-radius:12px;background:var(--el-bg-color)}\n.lab-patient-card .el-card__body{padding:16px 18px}\n.lab-patient-card--header{border-left:4px solid var(--el-color-primary)}\n.lab-patient-main{display:flex;align-items:center;gap:16px;min-width:0}\n.lab-patient-avatar{flex:none;background:var(--el-fill-color-light);border:1px solid var(--el-border-color)}\n.lab-patient-avatar-placeholder{width:62%;height:62%;fill:var(--el-text-color-secondary)}\n.lab-patient-identity{flex:1;min-width:0}\n.lab-patient-name-row{display:flex;align-items:center;flex-wrap:wrap;gap:7px}\n.lab-patient-name{margin-right:3px;color:var(--el-text-color-primary);font-size:20px;font-weight:750}\n.lab-patient-meta{margin-top:8px;color:var(--el-text-color-regular);font-size:13px}\n.lab-patient-sep{margin:0 8px;color:var(--el-text-color-placeholder)}\n.lab-rights{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}\n.lab-patient-chip{display:inline-flex;align-items:center;padding:2px 9px;border:1px solid var(--el-border-color-lighter);border-radius:999px;color:var(--el-text-color-regular);background:var(--el-fill-color-light);font-size:12px;font-weight:600}\n.lab-patient-chip.primary{color:var(--el-color-primary);background:var(--el-color-primary-light-9);border-color:var(--el-color-primary-light-8)}\n.lab-patient-chip.success{color:var(--el-color-success);background:var(--el-color-success-light-9);border-color:var(--el-color-success-light-8)}\n.lab-notice{margin-bottom:16px}\n.lab-action-row{margin-top:16px}\n.lab-test-group{margin-top:8px;padding:14px;border:1px solid var(--el-border-color-lighter);border-radius:10px;background:var(--el-fill-color-extra-light)}\n.lab-test-group .el-checkbox{margin-right:12px;margin-bottom:8px}\n.lab-choice-grid{padding:12px;border:1px solid var(--el-border-color-lighter);border-radius:10px}\n@media (max-width:700px){.lab-patient-main{align-items:flex-start}.lab-patient-avatar{width:58px!important;height:58px!important}.lab-patient-name{font-size:17px}.lab-patient-meta{line-height:1.8}.lab-patient-sep{display:none}}",
