      "fields": [
        {
          "key": 61008,
          "name": "Components",
          "component": "vue-ui",
          "category": "display_ui",
          "icon": "components-ui",
          "fieldType": "None",
          "fieldLength": null,
          "children": false,
          "enable": true,
          "formItemFlag": false,
          "options": {
            "name": "howto",
            "label": "Components",
            "columnSpan": 4,
            "hidden": false,
            "content": "<div class=\"apikey-howto\">\n  <el-steps direction=\"vertical\" :active=\"0\" :space=\"72\">\n    <el-step title=\"1. สร้างแถว key\" description=\"กรอก Partner · เลือก Service Account (user ที่สร้างไว้ให้ระบบนั้นโดยเฉพาะ) · เลือก Scopes = action ที่ให้ยิงได้ หรือเปิดสวิตช์ 'ทุก action' → กดบันทึก\" />\n    <el-step title=\"2. ออก key\" description=\"เปิดแถวที่บันทึกแล้ว → กดปุ่ม 'ออก key' → คัดลอก key จากกล่องส่งให้ partner ทางช่องทางที่ปลอดภัยทันที (ระบบเก็บแค่ hash ปิดกล่องแล้วดูซ้ำไม่ได้)\" />\n    <el-step title=\"3. partner เรียกใช้\" description=\"POST BASE_URL/v1/external/ACTION · header x-api-key: KEY · body { &quot;params&quot;: { ... } } · partner ดู action ที่ key ใช้ได้เองที่ GET BASE_URL/v1/external/actions\" />\n    <el-step title=\"4. ดูแลหลังใช้งาน\" description=\"ปิดชั่วคราว = ปิดสวิตช์ Active (401 ทันที เปิดกลับได้) · เปลี่ยน key = กด 'ออก key' ซ้ำ (key เดิมใช้ไม่ได้ทันที) · Key Prefix / Last Used / Calls ใช้ดูว่า partner ยังยิงอยู่ไหม\" />\n  </el-steps>\n</div>",
            "customClass": "",
            "onCreated": "",
            "onMounted": "",
            "onUnmount": ""
          },
          "id": "vue-ui61008"
        }
      ],
