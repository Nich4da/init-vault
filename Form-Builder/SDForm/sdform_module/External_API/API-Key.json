                        "onClick": "// ปุ่ม \"ออก key\" — ฟอร์ม API Key · button-ui `btn_issue` → Buttons Item → onClick\n// ยิง process api-key-issue แล้วโชว์ key ครั้งเดียวในกล่อง prompt (copy ได้ทันที)\n// 🔴 key จริงห้ามลงช่องไหนในฟอร์ม — ระบบเก็บแค่ hash ปิดกล่องแล้วดูซ้ำไม่ได้ (ต้องออกใหม่)\n// 🔴 6a98efecb113b44f84d3632b ถูกแทนด้วย id จริงตอน gen (gen-api-forms.cjs หาใน module_api ด้วย api_name)\nconst PROC_ISSUE = '6a98efecb113b44f84d3632b';   // api-key-issue\n\nif (String(PROC_ISSUE).indexOf('__') === 0) {\n\tthis.alert('ฟอร์มนี้ยัง import model เวอร์ชันเก่า (ยังไม่ได้แทน process id) — gen ใหม่แล้ว import อีกครั้ง', 'error');\n\treturn;\n}\n\nconst f = this.getFormRef();\nconst model = (typeof f.getFormData === 'function' && f.getFormData(false)) || {};\nconst keyId = String((f.formParams && f.formParams._id) || model._id || '');\nif (!keyId) {\n\tthis.alert('บันทึกแถวนี้ก่อน แล้วเปิดใหม่มากดออก key', 'warning');\n\treturn;\n}\n\nf.userState.runProcess(\n\tPROC_ISSUE,\n\t{ key_id: keyId },\n\t(res) => {\n\t\tconst d = (res && res.data) || {};\n\t\tif (!d.success || !d.key) {\n\t\t\tthis.alert(d.message || 'ออก key ไม่สำเร็จ', 'error');\n\t\t\treturn;\n\t\t}\n\t\t// โชว์ prefix ในช่องทันที (ค่าเดียวกับที่ DB เก็บ — บันทึกทับก็ไม่เสียหาย)\n\t\tif (typeof f.setFieldValue === 'function') f.setFieldValue('key_prefix', d.key_prefix || '');\n\t\tconst warn = d.unknown_scopes && d.unknown_scopes.length ? '\\n⚠️ scope ที่ยังไม่มีในทะเบียน action: ' + d.unknown_scopes.join(', ') : '';\n\t\tthis.prompt(\n\t\t\t'คัดลอก key นี้ส่งให้ partner ทางช่องทางที่ปลอดภัยทันที — ระบบไม่เก็บ key จริง ปิดกล่องแล้วดูซ้ำไม่ได้\\n' + d.message + warn,\n\t\t\t() => {},\n\t\t\t{ inputValue: d.key, confirmButtonText: 'ปิด', showCancelButton: false, inputPlaceholder: 'x-api-key' },\n\t\t\t'warning',\n\t\t\t'x-api-key · ' + (d.partner || '')\n\t\t);\n\t},\n\t() => this.alert('ออก key ไม่สำเร็จ — ดูข้อความแจ้งเตือนมุมจอ', 'error')\n);\n"
