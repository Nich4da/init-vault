{
  "fields": [
    {
      "key": 90101,
      "name": "Components",
      "component": "vue-ui",
      "category": "display_ui",
      "icon": "vue-ui",
      "fieldType": "None",
      "fieldLength": null,
      "children": false,
      "enable": true,
      "formItemFlag": false,
      "options": {
        "name": "emr_view",
        "label": "Components",
        "columnSpan": 24,
        "hidden": false,
        "customClass": "",
        "content": "<!-- emr_view · จอ \"EMR History\" (ฟอร์ม EMR Hisroty 6a96557e422c1ca959829eae)\n     อ่านอย่างเดียว — ภาพการรักษาของ visit ใบเดียว จาก snapshot ฟอร์ม Visit History\n\n     โครงจอ: หัวคนไข้+vital → แพ้ยา → [ซ้าย = SOAP · ขวา = ยา/Lab/X-ray/หัตถการ] → เงิน → อื่น ๆ\n       ซ้ายตอบ \"คนไข้เป็นอะไร\" ขวาตอบ \"หมอสั่งอะไร\" — 2 ฝั่งนี้ไม่สลับที่กัน แม้จอกว้างแค่ไหน\n     🔴 section ที่ไม่มีข้อมูล ซ่อนทั้งก้อน (v-if) — จอประวัติที่เต็มไปด้วย \"— ไม่มีข้อมูล —\" อ่านยากกว่าไม่มี\n     🔴 inline style ทั้งหมด: <style> ถูก DOMPurify ตัด และ Form CSS เป็นของกลางทั้งฟอร์ม\n     🔴 สีทุกจุดใช้ var(--el-*) → ตามธีม dark/light เอง ห้าม hardcode\n     🔴 root ต้องมี element เสมอ — v-if อยู่ข้างในเท่านั้น ไม่ใส่ที่ root -->\n\n<div style=\"padding:4px 2px 16px\">\n\n  <!-- ══ แถบบน: สถานะ + ไล่ดูครั้งอื่นของคนไข้คนเดียวกัน ══ -->\n  <div style=\"display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:10px\">\n    <span v-if=\"ehLoading\" style=\"font-size:12px;color:var(--el-text-color-secondary)\">กำลังโหลด…</span>\n\n    <!-- ไล่ดูครั้งอื่นของคนไข้คนเดียวกัน — ชุดควบคุมชิ้นเดียว: ปุ่มกลม ‹ › ขนาบป้ายบอกว่ากำลังดูใบไหน\n         🔴 ปุ่มกลม type=primary = ดูออกทันทีว่ากดได้ · วันที่ปลายทางไปอยู่ title (tooltip ของเบราว์เซอร์)\n            ไม่ยัดลงในปุ่มเป็นสองบรรทัด ซึ่งทำให้ตัวหนังสือเบียดกันจนอ่านยาก -->\n    <div v-if=\"ehNav && ehNav.total\"\n      style=\"display:inline-flex;align-items:center;gap:6px;padding:3px 4px;border-radius:999px;\n             border:1px solid var(--el-border-color-light);background:var(--el-fill-color-light)\">\n      <el-button circle type=\"primary\" size=\"large\" :disabled=\"!ehNav.prev || ehLoading\"\n        :title=\"ehNav.prev ? 'ดูการมาตรวจครั้งก่อน · ' + ehWhen(ehNav.prev.visit_date) : 'ไม่มีครั้งก่อนหน้าแล้ว'\"\n        @click=\"ehGo(ehNav.prev && ehNav.prev.visit_id)\">\n        <el-icon style=\"font-size:17px\"><arrow-left-bold /></el-icon>\n      </el-button>\n\n      <span style=\"display:inline-flex;flex-direction:column;align-items:center;line-height:1.2;padding:0 4px;min-width:104px\">\n        <span style=\"font-size:12.5px;font-weight:600;color:var(--el-text-color-primary);white-space:nowrap\">\n          {{ ehWhen(ehVisit && ehVisit.visit_date) }}\n        </span>\n        <span style=\"font-size:10.5px;color:var(--el-text-color-secondary);white-space:nowrap\">\n          ครั้งที่ {{ ehNav.index }} จาก {{ ehNav.total }}\n        </span>\n      </span>\n\n      <el-button circle type=\"primary\" size=\"large\" :disabled=\"!ehNav.next || ehLoading\"\n        :title=\"ehNav.next ? 'ดูการมาตรวจครั้งถัดไป · ' + ehWhen(ehNav.next.visit_date) : 'นี่คือครั้งล่าสุดแล้ว'\"\n        @click=\"ehGo(ehNav.next && ehNav.next.visit_id)\">\n        <el-icon style=\"font-size:17px\"><arrow-right-bold /></el-icon>\n      </el-button>\n    </div>\n\n    <span style=\"flex:1\"></span>\n    <span v-if=\"ehMeta && ehMeta.snapshot_at\" style=\"font-size:11.5px;color:var(--el-text-color-placeholder)\">\n      สรุปเมื่อ {{ ehWhen(ehMeta.snapshot_at) }}\n    </span>\n    <!-- พิมพ์ใบสรุปการรักษา (OPD Card) — reportId ถูก generator เติมให้จาก report-ids.cjs ห้าม hardcode\n         🔴 ต้องส่ง param ครบทุกตัวที่รายงานประกาศไว้ ไม่งั้น SdReport เด้ง dialog ถามผู้ใช้ก่อนพิมพ์ -->\n    <sd-report v-if=\"ehReady && ehVisit\"\n      :report-list=\"[{ reportId: '6a9679108ef1cc1e027f27ed', label: 'พิมพ์ใบสรุป', type: 'pdf' }]\"\n      :params=\"{ visit_id: ehVisit.visit_id }\"\n      size=\"small\" />\n    <el-button v-if=\"ehReady\" size=\"small\" plain @click=\"ehReload()\">โหลดใหม่</el-button>\n  </div>\n\n  <el-alert v-if=\"ehErr\" type=\"error\" :closable=\"false\" show-icon :title=\"ehErr\" style=\"margin-bottom:10px\" />\n\n  <div v-if=\"!ehReady && !ehLoading && !ehErr\" style=\"padding:24px 0;text-align:center;font-size:13px;color:var(--el-text-color-secondary)\">\n    ยังไม่ได้เลือกการมาตรวจที่จะแสดง\n  </div>\n\n  <template v-if=\"ehReady && ehVisit\">\n\n    <!-- ══ หัวจอ: คนไข้ + การมาตรวจ + สัญญาณชีพ (ค่าผิดปกติติดธงแดง) ══ -->\n    <div style=\"display:flex;flex-wrap:wrap;gap:14px;align-items:flex-start;padding:12px 14px;margin-bottom:10px;\n                border:1px solid var(--el-border-color-light);border-radius:8px;background:var(--el-fill-color-blank)\">\n\n      <el-avatar v-if=\"ehVisit.person.photo\" :src=\"ehVisit.person.photo\" :size=\"58\" style=\"flex:none\" />\n      <el-avatar v-else :size=\"58\" style=\"flex:none\">{{ (ehVisit.person.name || '?').slice(0, 1) }}</el-avatar>\n\n      <div style=\"flex:1;min-width:240px\">\n        <div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:8px\">\n          <span style=\"font-size:16px;font-weight:600\">{{ ehVisit.person.name || '-' }}</span>\n          <el-tag size=\"small\" type=\"primary\" effect=\"plain\">HN {{ ehVisit.hn || '-' }}</el-tag>\n          <el-tag size=\"small\" type=\"warning\" effect=\"plain\">VN {{ ehVisit.vn || '-' }}</el-tag>\n          <el-tag v-if=\"ehVisit.person.age\" size=\"small\" effect=\"plain\">{{ ehVisit.person.age }} · {{ ehVisit.person.gender }}</el-tag>\n          <el-tag v-if=\"ehVisit.person.blood\" size=\"small\" type=\"danger\" effect=\"plain\">เลือด {{ ehVisit.person.blood }}</el-tag>\n        </div>\n\n        <div style=\"display:flex;flex-wrap:wrap;gap:6px;margin-top:6px\">\n          <el-tag v-for=\"(ins, i) in ehVisit.inscl\" :key=\"'ins' + i\" size=\"small\" type=\"success\" effect=\"plain\">\n            {{ ins.main }}<span v-if=\"ins.sub\"> · {{ ins.sub }}</span>\n          </el-tag>\n        </div>\n\n        <div style=\"margin-top:6px;font-size:12px;line-height:1.6;color:var(--el-text-color-secondary)\">\n          <span>มาตรวจ {{ ehWhen(ehVisit.checkin_at) || ehWhen(ehVisit.visit_date) }}</span>\n          <span v-if=\"ehVisit.clinic\"> · {{ ehVisit.clinic }}</span>\n          <span v-if=\"ehVisit.room\"> · {{ ehVisit.room }}</span>\n          <span v-if=\"ehVisit.queue_label\"> · คิว {{ ehVisit.queue_label }}</span>\n          <span v-if=\"ehVisit.doctor\"> · แพทย์ {{ ehVisit.doctor }}</span>\n        </div>\n      </div>\n\n      <div v-if=\"ehVitals && ehVitals.has\" style=\"flex:none;display:flex;flex-wrap:wrap;gap:8px\">\n        <div v-if=\"ehVitals.bp_h != null\"\n          :style=\"{ minWidth: '78px', padding: '6px 10px', borderRadius: '6px', border: '1px solid ' + ((ehVitals.flags.bp_h || ehVitals.flags.bp_l) ? 'var(--el-color-danger-light-5)' : 'var(--el-border-color-lighter)') }\">\n          <div style=\"font-size:10.5px;color:var(--el-text-color-secondary)\">BP</div>\n          <div style=\"font-size:15px;font-weight:600\">\n            <span :style=\"{ color: ehVitalColor('bp_h') }\">{{ ehVitals.bp_h }}{{ ehFlagText('bp_h') }}</span>/<span :style=\"{ color: ehVitalColor('bp_l') }\">{{ ehVitals.bp_l }}{{ ehFlagText('bp_l') }}</span>\n            <span style=\"font-size:10px;font-weight:400;color:var(--el-text-color-placeholder)\"> mmHg</span>\n          </div>\n        </div>\n\n        <div v-if=\"ehVitals.pulse != null\"\n          :style=\"{ minWidth: '68px', padding: '6px 10px', borderRadius: '6px', border: '1px solid ' + (ehVitals.flags.pulse ? 'var(--el-color-danger-light-5)' : 'var(--el-border-color-lighter)') }\">\n          <div style=\"font-size:10.5px;color:var(--el-text-color-secondary)\">PR</div>\n          <div :style=\"{ fontSize: '15px', fontWeight: 600, color: ehVitalColor('pulse') }\">\n            {{ ehVitals.pulse }}{{ ehFlagText('pulse') }}<span style=\"font-size:10px;font-weight:400;color:var(--el-text-color-placeholder)\"> /นาที</span>\n          </div>\n        </div>\n\n        <div v-if=\"ehVitals.rr != null\"\n          :style=\"{ minWidth: '68px', padding: '6px 10px', borderRadius: '6px', border: '1px solid ' + (ehVitals.flags.rr ? 'var(--el-color-danger-light-5)' : 'var(--el-border-color-lighter)') }\">\n          <div style=\"font-size:10.5px;color:var(--el-text-color-secondary)\">RR</div>\n          <div :style=\"{ fontSize: '15px', fontWeight: 600, color: ehVitalColor('rr') }\">\n            {{ ehVitals.rr }}{{ ehFlagText('rr') }}<span style=\"font-size:10px;font-weight:400;color:var(--el-text-color-placeholder)\"> /นาที</span>\n          </div>\n        </div>\n\n        <div v-if=\"ehVitals.temp != null\"\n          :style=\"{ minWidth: '68px', padding: '6px 10px', borderRadius: '6px', border: '1px solid ' + (ehVitals.flags.temp ? 'var(--el-color-danger-light-5)' : 'var(--el-border-color-lighter)') }\">\n          <div style=\"font-size:10.5px;color:var(--el-text-color-secondary)\">Temp</div>\n          <div :style=\"{ fontSize: '15px', fontWeight: 600, color: ehVitalColor('temp') }\">\n            {{ ehVitals.temp }}{{ ehFlagText('temp') }}<span style=\"font-size:10px;font-weight:400;color:var(--el-text-color-placeholder)\"> °C</span>\n          </div>\n        </div>\n\n        <div v-if=\"ehVitals.weight || ehVitals.bmi\" style=\"min-width:96px;padding:6px 10px;border:1px solid var(--el-border-color-lighter);border-radius:6px\">\n          <div style=\"font-size:10.5px;color:var(--el-text-color-secondary)\">น้ำหนัก / BMI</div>\n          <div style=\"font-size:15px;font-weight:600\">\n            <span v-if=\"ehVitals.weight\">{{ ehVitals.weight }}<span style=\"font-size:10px;font-weight:400;color:var(--el-text-color-placeholder)\"> กก.</span></span>\n            <span v-if=\"ehVitals.bmi\"> · {{ ehVitals.bmi }}</span>\n          </div>\n          <div v-if=\"ehVitals.stature\" style=\"font-size:10.5px;color:var(--el-text-color-placeholder)\">\n            สูง {{ ehVitals.stature }} ซม.<span v-if=\"ehVitals.bsa\"> · BSA {{ ehVitals.bsa }}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══ แพ้ยา / แพ้สาร — ภาพ ณ วันที่มาตรวจ ══ -->\n    <div v-if=\"ehVisit.allergy_tags.length\"\n      style=\"display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:8px 12px;margin-bottom:10px;\n             border:1px solid var(--el-color-danger-light-5);border-radius:8px;background:var(--el-color-danger-light-9)\">\n      <span style=\"font-size:12px;font-weight:600;color:var(--el-color-danger)\">แพ้ยา</span>\n      <el-tag v-for=\"(a, i) in ehVisit.allergy_tags\" :key=\"'alg' + i\" size=\"small\" type=\"danger\" effect=\"light\">{{ a }}</el-tag>\n    </div>\n\n    <!-- ══ ตัวจอ: ซ้าย = SOAP (บันทึกทางคลินิก) · ขวา = สิ่งที่สั่ง (ยา/Lab/X-ray/หัตถการ) ══\n         🔴 แบ่ง 2 ฝั่งถาวร ไม่ปล่อยให้ auto-fit สลับที่ — หมอกวาดตาซ้าย \"เป็นอะไร\" ขวา \"สั่งอะไร\"\n            จอแคบกว่า ~760px จะตกเป็นคอลัมน์เดียว (SOAP ก่อน แล้วรายการสั่ง) -->\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:10px;align-items:start\">\n\n      <!-- ─────────── ซ้าย: S → O → A → P ─────────── -->\n      <div style=\"display:flex;flex-direction:column;gap:10px\">\n\n        <div v-if=\"ehSubjective && ehSubjective.has\"\n          style=\"padding:12px 14px;border:1px solid var(--el-border-color-light);border-radius:8px;background:var(--el-fill-color-blank)\">\n          <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:8px\">\n            <el-tag size=\"small\" type=\"primary\" effect=\"dark\">S</el-tag>\n            <span style=\"font-size:13px;font-weight:600\">ประวัติอาการ</span>\n            <span style=\"flex:1\"></span>\n            <el-button v-if=\"ehSubjective.data_id\" size=\"small\" text @click=\"ehOpen(ehSubjective.form_id, ehSubjective.data_id)\">ดูใบ</el-button>\n          </div>\n\n          <div v-if=\"ehSubjective.cc\" style=\"margin-bottom:8px\">\n            <div style=\"font-size:11.5px;color:var(--el-color-primary);font-weight:600\">CC — อาการสำคัญ</div>\n            <div style=\"font-size:13px;line-height:1.55;white-space:pre-line;overflow-wrap:anywhere\">{{ ehSubjective.cc }}</div>\n          </div>\n          <div v-if=\"ehSubjective.hpi\" style=\"margin-bottom:8px\">\n            <div style=\"font-size:11.5px;color:var(--el-color-primary);font-weight:600\">HPI — ประวัติปัจจุบัน</div>\n            <div style=\"font-size:13px;line-height:1.55;white-space:pre-line;overflow-wrap:anywhere\">{{ ehSubjective.hpi }}</div>\n          </div>\n          <div v-if=\"ehSubjective.past\" style=\"margin-bottom:8px\">\n            <div style=\"font-size:11.5px;color:var(--el-text-color-secondary);font-weight:600\">ประวัติเจ็บป่วยในอดีต</div>\n            <div style=\"font-size:13px;line-height:1.55;white-space:pre-line;overflow-wrap:anywhere\">{{ ehSubjective.past }}</div>\n          </div>\n          <div v-if=\"ehSubjective.congenital\" style=\"margin-bottom:8px\">\n            <div style=\"font-size:11.5px;color:var(--el-text-color-secondary);font-weight:600\">โรคประจำตัว</div>\n            <div style=\"font-size:13px;line-height:1.55;white-space:pre-line;overflow-wrap:anywhere\">{{ ehSubjective.congenital }}</div>\n          </div>\n          <div v-if=\"ehSubjective.family\">\n            <div style=\"font-size:11.5px;color:var(--el-text-color-secondary);font-weight:600\">ประวัติครอบครัว</div>\n            <div style=\"font-size:13px;line-height:1.55;white-space:pre-line;overflow-wrap:anywhere\">{{ ehSubjective.family }}</div>\n          </div>\n\n          <div v-if=\"ehSubjective.by\" style=\"margin-top:8px;font-size:11px;color:var(--el-text-color-placeholder)\">\n            {{ ehSubjective.by }}<span v-if=\"ehSubjective.at\"> · {{ ehWhen(ehSubjective.at) }}</span>\n          </div>\n        </div>\n\n        <div v-if=\"ehPe && ehPe.has\"\n          style=\"padding:12px 14px;border:1px solid var(--el-border-color-light);border-radius:8px;background:var(--el-fill-color-blank)\">\n          <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:8px\">\n            <el-tag size=\"small\" type=\"warning\" effect=\"dark\">O</el-tag>\n            <span style=\"font-size:13px;font-weight:600\">ตรวจร่างกาย (PE)</span>\n            <el-tag v-if=\"ehPe.abnormal_count\" size=\"small\" type=\"danger\" effect=\"plain\">ผิดปกติ {{ ehPe.abnormal_count }}</el-tag>\n            <span style=\"flex:1\"></span>\n            <el-button v-if=\"ehPe.data_id\" size=\"small\" text @click=\"ehOpen(ehPe.form_id, ehPe.data_id)\">ดูใบ</el-button>\n          </div>\n\n          <div v-for=\"(p, i) in ehPeItems()\" :key=\"'pe' + i\"\n            style=\"display:flex;align-items:baseline;gap:8px;padding:3px 0;font-size:13px;line-height:1.5;\n                   border-bottom:1px solid var(--el-border-color-lighter)\">\n            <span style=\"flex:none;min-width:100px;color:var(--el-text-color-secondary)\">{{ p.name }}</span>\n            <span :style=\"{ flex: 1, minWidth: 0, overflowWrap: 'anywhere', color: p.abnormal ? 'var(--el-color-danger)' : 'inherit' }\">\n              {{ p.findings || (p.abnormal ? 'ผิดปกติ' : 'ปกติ') }}\n            </span>\n          </div>\n\n          <div v-if=\"ehPe.abnormal_count && ehPe.normal_count\" style=\"margin-top:4px\">\n            <el-button size=\"small\" text @click=\"ehTogglePe()\">\n              {{ ehUi.showNormalPe ? 'ซ่อนรายการที่ปกติ' : 'ดูรายการที่ปกติอีก ' + ehPe.normal_count + ' รายการ' }}\n            </el-button>\n          </div>\n\n          <!-- note เป็น html-input ⇒ render เป็น html (ข้อมูลจากฟอร์มในระบบ ไม่ใช่ข้อมูลนอก) -->\n          <div v-if=\"ehPe.note\" v-html=\"ehPe.note\" style=\"margin-top:6px;font-size:12.5px;line-height:1.55;overflow-wrap:anywhere\"></div>\n\n          <div v-if=\"ehPe.by\" style=\"margin-top:8px;font-size:11px;color:var(--el-text-color-placeholder)\">\n            {{ ehPe.by }}<span v-if=\"ehPe.at\"> · {{ ehWhen(ehPe.at) }}</span>\n          </div>\n        </div>\n\n        <div v-if=\"ehDx && ehDx.has\"\n          style=\"padding:12px 14px;border:1px solid var(--el-color-danger-light-7);border-radius:8px;background:var(--el-fill-color-blank)\">\n          <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:8px\">\n            <el-tag size=\"small\" type=\"danger\" effect=\"dark\">A</el-tag>\n            <span style=\"font-size:13px;font-weight:600\">วินิจฉัยโรค</span>\n            <span style=\"flex:1\"></span>\n            <el-button v-if=\"ehDx.data_id\" size=\"small\" text @click=\"ehOpen(ehDx.form_id, ehDx.data_id)\">ดูใบ</el-button>\n          </div>\n\n          <div v-for=\"(d, i) in ehDx.items\" :key=\"'dx' + i\" style=\"display:flex;align-items:baseline;gap:6px;padding:3px 0;font-size:13.5px;line-height:1.5\">\n            <el-tag :type=\"d.primary ? 'danger' : 'info'\" size=\"small\" effect=\"plain\" style=\"flex:none\">\n              {{ d.primary ? 'หลัก' : (d.dx_type || 'ร่วม') }}\n            </el-tag>\n            <span style=\"flex:1;min-width:0;overflow-wrap:anywhere\">{{ d.text }}</span>\n          </div>\n\n          <div v-if=\"ehDx.doctor\" style=\"margin-top:8px;font-size:11px;color:var(--el-text-color-placeholder)\">แพทย์ผู้วินิจฉัย {{ ehDx.doctor }}</div>\n        </div>\n\n        <div v-if=\"ehPlan && ehPlan.has\"\n          style=\"padding:12px 14px;border:1px solid var(--el-border-color-light);border-radius:8px;background:var(--el-fill-color-blank)\">\n          <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:8px\">\n            <el-tag size=\"small\" type=\"success\" effect=\"dark\">P</el-tag>\n            <span style=\"font-size:13px;font-weight:600\">แผนการรักษา</span>\n            <span style=\"flex:1\"></span>\n            <el-button v-if=\"ehPlan.data_id\" size=\"small\" text @click=\"ehOpen(ehPlan.form_id, ehPlan.data_id)\">ดูใบ</el-button>\n          </div>\n\n          <div v-if=\"ehPlan.disposition\" style=\"margin-bottom:6px;font-size:13px\">\n            <span style=\"color:var(--el-text-color-secondary)\">การจำหน่าย:</span> {{ ehPlan.disposition }}\n          </div>\n          <div v-if=\"ehPlan.sick_leave_days\" style=\"margin-bottom:6px;font-size:13px\">\n            <span style=\"color:var(--el-text-color-secondary)\">ใบลาป่วย:</span> {{ ehPlan.sick_leave_days }} วัน\n          </div>\n          <div v-if=\"ehPlan.education\" style=\"margin-bottom:6px\">\n            <div style=\"font-size:11.5px;color:var(--el-text-color-secondary);font-weight:600\">คำแนะนำผู้ป่วย</div>\n            <div v-html=\"ehPlan.education\" style=\"font-size:12.5px;line-height:1.55;overflow-wrap:anywhere\"></div>\n          </div>\n          <div v-if=\"ehPlan.safety_net\">\n            <div style=\"font-size:11.5px;color:var(--el-color-danger);font-weight:600\">อาการที่ต้องรีบกลับมาก่อนนัด</div>\n            <div v-html=\"ehPlan.safety_net\" style=\"font-size:12.5px;line-height:1.55;overflow-wrap:anywhere\"></div>\n          </div>\n        </div>\n\n        <div v-if=\"ehConsults.length\"\n          style=\"padding:12px 14px;border:1px solid var(--el-border-color-light);border-radius:8px;background:var(--el-fill-color-blank)\">\n          <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:8px\">\n            <span style=\"font-size:13px;font-weight:600\">ปรึกษา</span>\n            <el-tag size=\"small\" effect=\"plain\">{{ ehConsults.length }}</el-tag>\n          </div>\n\n          <div v-for=\"(c, i) in ehConsults\" :key=\"'cs' + i\"\n            style=\"padding:6px 0;border-bottom:1px solid var(--el-border-color-lighter);cursor:pointer\"\n            @click=\"ehOpen(c.form_id, c.data_id)\">\n            <div style=\"display:flex;align-items:center;gap:6px;flex-wrap:wrap\">\n              <el-tag :type=\"ehConsultColor(c.status)\" size=\"small\" effect=\"plain\">{{ ehConsultLabel(c.status) }}</el-tag>\n              <span style=\"font-size:13px;font-weight:500\">{{ c.to || c.clinic || '-' }}</span>\n              <span v-if=\"c.at\" style=\"font-size:11px;color:var(--el-text-color-placeholder)\">{{ ehWhen(c.at) }}</span>\n            </div>\n            <div v-if=\"c.reason\" style=\"margin-top:2px;font-size:12.5px;line-height:1.5;overflow-wrap:anywhere\">{{ c.reason }}</div>\n            <div v-if=\"c.soap_p\" style=\"margin-top:2px;font-size:12px;color:var(--el-text-color-secondary);overflow-wrap:anywhere\">ตอบกลับ: {{ c.soap_p }}</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- ─────────── ขวา: สิ่งที่สั่ง — ยา → Lab → X-ray → หัตถการ → เวชภัณฑ์ ───────────\n           process เรียงกลุ่มมาให้แล้ว (TYPE_ORDER) · รวมข้ามใบสั่ง แต่ละบรรทัดบอกว่ามาจากใบไหน -->\n      <div style=\"display:flex;flex-direction:column;gap:10px\">\n\n        <div v-if=\"!ehGroups.length\" style=\"padding:12px 14px;border:1px dashed var(--el-border-color);border-radius:8px;\n                    font-size:12.5px;color:var(--el-text-color-placeholder)\">\n          — ครั้งนี้ไม่มีการสั่งยา / ตรวจ / หัตถการ —\n        </div>\n\n        <div v-for=\"(g, gi) in ehGroups\" :key=\"'grp' + gi\"\n          :style=\"{ padding: '12px 14px', borderRadius: '8px', background: 'var(--el-fill-color-blank)',\n                    border: '1px solid ' + (g.type === 'med' ? 'var(--el-color-success-light-7)' : 'var(--el-border-color-light)') }\">\n          <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:6px\">\n            <el-tag :type=\"g.type === 'med' ? 'success' : ehTypeColor(g.type)\" size=\"small\" effect=\"dark\">{{ g.type === 'med' ? 'Rx' : g.label }}</el-tag>\n            <span v-if=\"g.type === 'med'\" style=\"font-size:13px;font-weight:600\">ยาที่สั่ง</span>\n            <el-tag size=\"small\" effect=\"plain\">{{ g.count }} รายการ</el-tag>\n            <span style=\"flex:1\"></span>\n            <span style=\"font-size:14px;font-weight:700;color:var(--el-text-color-primary)\">฿{{ ehMoneyText(g.total) }}</span>\n          </div>\n\n          <div v-for=\"(it, ii) in g.items\" :key=\"'gi' + gi + '_' + ii\"\n            style=\"padding:5px 0;border-top:1px solid var(--el-border-color-lighter);cursor:pointer\"\n            @click=\"ehOpen(it.form_id, it.data_id)\">\n            <div style=\"display:flex;align-items:baseline;gap:6px\">\n              <span :style=\"{ flex: 1, minWidth: 0, fontSize: '13.5px', fontWeight: g.type === 'med' ? 500 : 400, lineHeight: 1.45,\n                              overflowWrap: 'anywhere', textDecoration: it.cancelled ? 'line-through' : 'none' }\">{{ it.name }}</span>\n              <el-tag v-if=\"it.cancelled\" size=\"small\" type=\"danger\" effect=\"plain\" style=\"flex:none\">ยกเลิก</el-tag>\n              <span v-if=\"g.type === 'med' || it.qty > 1\" style=\"flex:none;font-size:12px;color:var(--el-text-color-secondary)\">× {{ it.qty }}</span>\n            </div>\n            <div v-if=\"it.sig\" style=\"font-size:12.5px;line-height:1.5;color:var(--el-text-color-regular);overflow-wrap:anywhere\">{{ it.sig }}</div>\n            <div style=\"display:flex;align-items:baseline;gap:6px;font-size:11px;color:var(--el-text-color-placeholder)\">\n              <span style=\"flex:1;min-width:0;overflow-wrap:anywhere\">\n                <span v-if=\"it.indication\">ข้อบ่งใช้: {{ it.indication }} · </span>\n                <span>{{ it.order_number }} · {{ ehStatusLabel(it.order_status) }}</span>\n                <span v-if=\"it.order_at\"> · {{ ehWhen(it.order_at) }}</span>\n              </span>\n              <!-- ราคาต่อบรรทัด: หมอกวาดตาหาตัวเลขเงินก่อนตัวอื่น ⇒ ต้องเด่นกว่าข้อความรอบข้าง -->\n              <span v-if=\"it.net_amount\" style=\"flex:none;font-size:13px;font-weight:600;color:var(--el-text-color-regular)\">฿{{ ehMoneyText(it.net_amount) }}</span>\n            </div>\n            <div v-if=\"it.comment\" style=\"font-size:11.5px;color:var(--el-text-color-placeholder);overflow-wrap:anywhere\">หมายเหตุ: {{ it.comment }}</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══ การเงิน — แยก \"สั่งไป\" กับ \"ออกบิลแล้ว\" (2 ยอดนี้ไม่เท่ากันเป็นปกติ) ══ -->\n    <div v-if=\"ehMoney && ehMoney.has\"\n      style=\"display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:10px;padding:10px 14px;\n             border:1px solid var(--el-border-color-light);border-radius:8px;background:var(--el-fill-color-light)\">\n      <span style=\"font-size:13px;font-weight:600\">การเงิน</span>\n      <span style=\"font-size:13px\"><span style=\"color:var(--el-text-color-secondary)\">มูลค่าที่สั่ง</span> ฿{{ ehMoneyText(ehMoney.ordered) }}</span>\n      <span style=\"font-size:13px\"><span style=\"color:var(--el-text-color-secondary)\">ออกบิลแล้ว</span> ฿{{ ehMoneyText(ehMoney.total) }}</span>\n      <span style=\"font-size:13px\"><span style=\"color:var(--el-text-color-secondary)\">ชำระแล้ว</span> ฿{{ ehMoneyText(ehMoney.paid) }}</span>\n      <span v-if=\"ehMoney.outstanding\" style=\"font-size:13px;color:var(--el-color-danger)\">ค้างชำระ ฿{{ ehMoneyText(ehMoney.outstanding) }}</span>\n      <el-tag v-if=\"ehMoney.status_text\" size=\"small\" effect=\"plain\">{{ ehMoney.status_text }}</el-tag>\n      <span v-if=\"ehMoney.ordered > ehMoney.total\" style=\"font-size:11.5px;color:var(--el-text-color-placeholder)\">\n        (ส่วนต่างคือรายการที่ยังไม่ได้ออกบิล)\n      </span>\n    </div>\n\n    <!-- ══ บันทึกอื่น ๆ — ก้อนที่จอนี้ไม่มีหัวข้อเฉพาะให้ (ทะเบียนโรค / ใบเสร็จ / ฟอร์มที่เพิ่มทีหลัง) ══ -->\n    <div v-if=\"ehOthers.length\" style=\"margin-top:10px\">\n      <el-collapse v-model=\"ehUi.showOther\">\n        <el-collapse-item name=\"other\">\n          <template #title>\n            <span style=\"font-size:13px;font-weight:600\">บันทึกอื่น ๆ ในการมาตรวจครั้งนี้ ({{ ehOthers.length }} ฟอร์ม)</span>\n          </template>\n          <div v-for=\"(b, bi) in ehOthers\" :key=\"'ob' + bi\" style=\"margin-bottom:10px\">\n            <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:4px\">\n              <span style=\"font-size:12.5px;font-weight:600\">{{ b.form_name }}</span>\n              <el-tag size=\"small\" effect=\"plain\">{{ b.count }}</el-tag>\n            </div>\n\n            <div v-for=\"(r, ri) in b.rows\" :key=\"'obr' + bi + '_' + ri\"\n              style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;margin-bottom:6px;\n                     border:1px solid var(--el-border-color-light);border-radius:8px;background:var(--el-fill-color-blank)\">\n              <div style=\"flex:1;min-width:0\">\n                <div style=\"display:flex;flex-wrap:wrap;gap:4px 12px;font-size:12.5px;line-height:1.5\">\n                  <span v-for=\"(f, fi) in r.fields\" :key=\"'obf' + bi + '_' + ri + '_' + fi\" style=\"overflow-wrap:anywhere\">\n                    <span style=\"color:var(--el-text-color-secondary)\">{{ f.label }}</span> {{ f.value }}\n                  </span>\n                  <span v-if=\"!r.fields.length\" style=\"color:var(--el-text-color-placeholder)\">(ไม่มีข้อมูลสรุป)</span>\n                </div>\n                <div style=\"font-size:11px;color:var(--el-text-color-placeholder)\">\n                  {{ ehWhen(r.at) }}<span v-if=\"r.by\"> · {{ r.by }}</span>\n                </div>\n              </div>\n              <!-- ปุ่มชัด ๆ — เดิมทั้งแถวกดได้แต่ไม่มีอะไรบอก คนเลยไม่รู้ว่ากดตรงไหน -->\n              <el-button size=\"small\" type=\"primary\" plain style=\"flex:none\" @click=\"ehOpen(b.form_id, r.data_id)\">เปิดดู</el-button>\n            </div>\n          </div>\n        </el-collapse-item>\n      </el-collapse>\n    </div>\n\n    <!-- ══ ใบสั่งต้นทาง — รายการข้างบนรวมข้ามใบไปแล้ว ตรงนี้ไว้ตามกลับไปที่ใบจริง ══ -->\n    <div v-if=\"ehOrders.length\" style=\"margin-top:10px;display:flex;flex-wrap:wrap;align-items:center;gap:8px\">\n      <span style=\"font-size:11.5px;color:var(--el-text-color-placeholder)\">ใบสั่งต้นทาง</span>\n      <el-button v-for=\"(o, oi) in ehOrders\" :key=\"'ordbtn' + oi\" size=\"small\" plain @click=\"ehOpen(o.form_id, o.data_id)\">\n        {{ ehTypeLabel(o.type) }} · {{ o.order_number }}\n      </el-button>\n    </div>\n\n    <div v-if=\"ehMeta\" style=\"margin-top:12px;font-size:11px;color:var(--el-text-color-placeholder)\">\n      ข้อมูลจากสรุปการมาตรวจ · {{ ehMeta.block_count }} ก้อน / {{ ehMeta.row_count }} แถว\n      <span v-if=\"ehMeta.built_at\"> · สร้างเมื่อ {{ ehWhen(ehMeta.built_at) }}</span>\n      <span v-if=\"ehMeta.built_by\"> โดย {{ ehMeta.built_by }}</span>\n    </div>\n\n  </template>\n</div>\n",
        "onCreated": "/**\n * emr_view · onCreated — จอ \"EMR History\" (ฟอร์ม EMR Hisroty 6a96557e422c1ca959829eae)\n *\n * วางที่: vue-ui `emr_view` (ฟอร์มนี้มี widget ตัวเดียว เต็มจอ)\n * หน้าที่: แสดงการรักษาของ **visit ใบเดียว** แบบอ่านอย่างเดียว — เปิดจากปุ่ม \"ดูทั้งใบ\" ในหน้า EMR\n *\n * รับ context 2 ทาง (เรียงตามลำดับที่ลอง):\n *   1) formParams.visit_id / formParams.history_id  ← ทางปกติ (openForm ส่ง params มา)\n *   2) s.ehLoad(visitId) จากภายนอก                  ← เผื่อจอเปิดค้างแล้วอยากสลับใบ\n *\n * 🔴 ทุก key ที่เทมเพลตอ้างต้องมีค่าตั้งแต่ตรงนี้ — ขาดตัวเดียว = error box ทั้ง widget\n * 🔴 v-model ผูก object เท่านั้น (ehUi.tab) — scope proxy ไม่มี set trap ให้ตัวแปรเดี่ยว\n * 🔴 อ่านอย่างเดียวจริง ๆ: ไม่มีปุ่มบันทึก/ลบ · ปุ่มที่มีคือ \"เปิดใบต้นทาง\" ซึ่งเปิดฟอร์มจริงของ record นั้น\n */\n\nconst s = this.vueState;\nconst field = this;\n\nconst HISTORY_PROC = '6a9662a75723cd050ea497e0'; // emr-history-get (generator เติมให้ตอน build model)\n\n/* ══ state ════════════════════════════════════════════════════════════════ */\ns.ehLoading = false;\ns.ehErr = '';\ns.ehReady = false; // โหลดสำเร็จแล้วอย่างน้อย 1 ครั้ง\ns.ehVisit = null;\ns.ehVitals = null;\ns.ehSubjective = null;\ns.ehPe = null;\ns.ehDx = null;\ns.ehPlan = null;\ns.ehConsults = [];\ns.ehOrders = [];\ns.ehMoney = null;\ns.ehOthers = [];\ns.ehMeta = null;\ns.ehNav = null; // { prev, next, index, total } — ไล่ดู visit อื่นของคนไข้คนเดียวกัน\ns.ehGroups = []; // รายการสั่งรวมทุกใบ จัดตามชนิด (ยา/Lab/X-ray/หัตถการ)\ns.ehUi = { showOther: [], showNormalPe: false }; // el-collapse v-model รับ array ของ name ที่เปิดอยู่\n\n/* ══ helper ที่เทมเพลตเรียก ══════════════════════════════════════════════ */\n\n// \"2026-09-01 10:55:24\" / \"2026-09-01\" → \"01/09/2569 10:55\" (พ.ศ. ตาม convention ของระบบ)\ns.ehWhen = (v) => {\n\tconst t = String(v || '');\n\tif (t.length < 10) return t;\n\tconst d = t.slice(8, 10) + '/' + t.slice(5, 7) + '/' + (Number(t.slice(0, 4)) + 543);\n\treturn t.length >= 16 ? d + ' ' + t.slice(11, 16) : d;\n};\n\ns.ehMoneyText = (n) => {\n\tconst x = Number(n);\n\tif (!Number.isFinite(x)) return '-';\n\treturn x.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n};\n\n// ป้ายชนิดใบสั่ง/รายการ — ชนิดที่ระบบใช้จริง: med / lab / xray / nurs / order\ns.ehTypeLabel = (t) => {\n\tconst map = { med: 'ยา', drug: 'ยา', lab: 'Lab', xray: 'X-ray', nurs: 'หัตถการ', order: 'เวชภัณฑ์' };\n\treturn map[String(t || '').toLowerCase()] || t || 'อื่นๆ';\n};\n\ns.ehTypeColor = (t) => {\n\tconst map = { med: 'success', drug: 'success', lab: 'primary', xray: 'warning', nurs: 'info', order: 'info' };\n\treturn map[String(t || '').toLowerCase()] || 'info';\n};\n\n// สถานะใบสั่ง — ตัวที่พบจริงใน status_stage ของ CPOE\ns.ehStatusLabel = (st) => {\n\tconst map = {\n\t\tdraft: 'ร่าง',\n\t\tsent: 'ส่งแล้ว',\n\t\treceived: 'รับแล้ว',\n\t\tprepared: 'จัดแล้ว',\n\t\tdispensed: 'จ่ายแล้ว',\n\t\tcompleted: 'เสร็จสิ้น',\n\t\tcancelled: 'ยกเลิก',\n\t\tcanceled: 'ยกเลิก',\n\t};\n\treturn map[String(st || '').toLowerCase()] || st || '';\n};\n\n// ป้ายการปรึกษา — ค่าจริงในฟอร์ม Consult\ns.ehConsultLabel = (st) => {\n\tconst map = { draft: 'ร่าง', send: 'ส่งปรึกษา', accept: 'รับปรึกษา', reply: 'ตอบกลับแล้ว', complete: 'เสร็จสิ้น', cancel: 'ยกเลิก' };\n\treturn map[String(st || '').toLowerCase()] || st || '';\n};\n\ns.ehConsultColor = (st) => {\n\tconst t = String(st || '').toLowerCase();\n\tif (t === 'cancel') return 'danger';\n\tif (t === 'complete' || t === 'reply') return 'success';\n\tif (t === 'draft') return 'info';\n\treturn 'warning';\n};\n\n// สีของค่าสัญญาณชีพตามธงที่ process คำนวณให้ (อิงช่วงปกติตามอายุ)\ns.ehVitalColor = (key) => {\n\tconst f = s.ehVitals && s.ehVitals.flags ? s.ehVitals.flags[key] : '';\n\treturn f ? 'var(--el-color-danger)' : 'inherit';\n};\n\n// ป้ายกำกับท้ายค่าที่ผิดปกติ — หมอเห็นแล้วรู้ทันทีว่าสูงหรือต่ำ ไม่ต้องเทียบช่วงเอง\ns.ehFlagText = (key) => {\n\tconst f = s.ehVitals && s.ehVitals.flags ? s.ehVitals.flags[key] : '';\n\treturn f === 'high' ? '↑' : f === 'low' ? '↓' : '';\n};\n\n// PE: แสดงเฉพาะที่ผิดปกติก่อน — กดแล้วค่อยกางที่ปกติ\ns.ehPeItems = () => {\n\tconst items = (s.ehPe && s.ehPe.items) || [];\n\tif (s.ehUi.showNormalPe) return items;\n\tconst bad = items.filter((p) => p.abnormal);\n\treturn bad.length ? bad : items; // ปกติทั้งหมด → แสดงตามเดิม ไม่ให้จอว่างเปล่า\n};\n\ns.ehTogglePe = () => {\n\ts.ehUi.showNormalPe = !s.ehUi.showNormalPe;\n};\n\n// ไปใบก่อนหน้า / ถัดไปของคนไข้คนเดียวกัน (ปุ่ม ‹ › บนหัวจอ)\ns.ehGo = (visitId) => {\n\tif (!visitId) return;\n\ts.ehLoad(String(visitId), null);\n};\n\n/* ══ เปิด record ต้นทาง ═══════════════════════════════════════════════════ */\ns.ehOpen = (formId, dataId) => {\n\tif (!formId || !dataId) return;\n\tconst form = field.getFormRef();\n\tif (!form) return;\n\tform.openForm(String(formId), String(dataId), '', null, {\n\t\t// 🔴 readonly: true = โหมดดู — ซ่อน Submit/Reset และ disable ทุกช่อง (SdCrudForm.formReadonly)\n\t\t//    ไม่ใส่ = popup เปิดเป็นโหมดแก้ไข ซึ่งขัดกับเจตนาของจอประวัติทั้งจอ\n\t\treadonly: true,\n\t\t// 🔴 ต้อง spread formParams ของแม่ ไม่งั้น popup ไม่เหลือ xsitex/xunitx (ระบบใช้ตัดสิน site/unit)\n\t\tparams: Object.assign({}, form.formParams),\n\t\tcancelCallback: () => form.subFormClose(),\n\t});\n};\n\n/* ══ โหลดข้อมูล ═══════════════════════════════════════════════════════════ */\ns.ehLoad = (visitId, historyId) => {\n\tconst form = field.getFormRef();\n\tif (!form) return;\n\t// 🔴 กันเคส \"import model เวอร์ชันที่ generator ยังไม่ได้เติม process id\"\n\t//    ปล่อยไว้จะยิง API ด้วยชื่อ token → backend ตอบ \"API not found\" ซึ่งอ่านไม่ออกว่าเกิดจากอะไร\n\tif (String(HISTORY_PROC).indexOf('__') === 0) {\n\t\ts.ehErr = 'ฟอร์มนี้ยัง import model เวอร์ชันเก่าอยู่ (ยังไม่มี process id) — import ไฟล์ล่าสุดจาก generator แล้ว hard reload';\n\t\ts.ehReady = true;\n\t\treturn;\n\t}\n\n\tif (!visitId && !historyId) {\n\t\ts.ehErr = 'ไม่ได้รับ visit ที่จะแสดง (ต้องเปิดจอนี้พร้อม visit_id)';\n\t\treturn;\n\t}\n\n\ts.ehLoading = true;\n\ts.ehErr = '';\n\t// สลับใบ = ล้างของเดิมก่อน ไม่งั้นระหว่างโหลดจอโชว์ข้อมูลคนละ visit ปนกัน\n\ts.ehUi.showNormalPe = false;\n\tform.userState.runProcess(\n\t\tHISTORY_PROC,\n\t\t{ visit_id: visitId || null, history_id: historyId || null },\n\t\t(res) => {\n\t\t\ts.ehLoading = false;\n\t\t\tconst d = (res && res.data) || {};\n\t\t\t// process ที่ตีกลับด้วย success:false มาทาง callback นี้เหมือนกัน ไม่ใช่ errCb\n\t\t\tif (!d.success) {\n\t\t\t\ts.ehErr = d.message || 'อ่านประวัติการรักษาไม่สำเร็จ';\n\t\t\t\treturn;\n\t\t\t}\n\t\t\ts.ehVisit = d.visit || null;\n\t\t\ts.ehVitals = d.vitals || null;\n\t\t\ts.ehSubjective = d.subjective || null;\n\t\t\ts.ehPe = d.pe || null;\n\t\t\ts.ehDx = d.dx || null;\n\t\t\ts.ehPlan = d.plan || null;\n\t\t\ts.ehConsults = Array.isArray(d.consults) ? d.consults : [];\n\t\t\ts.ehOrders = Array.isArray(d.orders) ? d.orders : [];\n\t\t\ts.ehGroups = Array.isArray(d.item_groups) ? d.item_groups : [];\n\t\t\ts.ehNav = d.nav || null;\n\t\t\ts.ehMoney = d.money || null;\n\t\t\ts.ehOthers = Array.isArray(d.others) ? d.others : [];\n\t\t\ts.ehMeta = d.meta || null;\n\t\t\ts.ehReady = true;\n\t\t},\n\t\t(err) => {\n\t\t\ts.ehLoading = false;\n\t\t\ts.ehErr = 'อ่านประวัติการรักษาไม่สำเร็จ: ' + ((err && err.message) || err);\n\t\t},\n\t);\n};\n\ns.ehReload = () => {\n\tif (s.ehVisit) s.ehLoad(s.ehVisit.visit_id, null);\n\telse s.ehBoot();\n};\n\n// อ่าน context จาก params ที่ openForm ส่งเข้ามา — เรียกจาก onMounted (formRef พร้อมแล้วตอนนั้น)\ns.ehBoot = () => {\n\tconst p = field.formParams || {};\n\tconst visitId = p.visit_id || p.visitId || p.vid || null;\n\tconst historyId = p.history_id || p.historyId || p.dataId || null;\n\ts.ehLoad(visitId, historyId);\n};\n",
        "onMounted": "/**\n * emr_view · onMounted — อ่าน params ที่เปิดจอมาแล้วโหลดประวัติ\n * (onCreated ยังไม่มี getFormRef() → ต้องเรียกตอน mounted)\n */\nconst s = this.vueState;\nif (s && s.ehBoot) s.ehBoot();\n",
        "onUnmount": ""
      },
      "id": "vue-ui90101"
    }
