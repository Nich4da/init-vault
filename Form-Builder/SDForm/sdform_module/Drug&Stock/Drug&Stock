มน์ตัวเลขที่สั้นอยู่แล้ว (ราคาทุน/มูลค่า/คงเหลือสะสม) แทนการดันตารางให้กว้างขึ้น */\n/* ความกว้างจริงมาจาก --ss-mcols ที่ movGrid() คำนวณตามคอลัมน์ที่เปิดอยู่\n   ค่า fallback = ครบ 10 ช่อง เผื่อ movData ยังไม่มา (แถวยังไม่กางไม่มีตารางอยู่แล้ว) */\n.ss-mhead,.ss-mrow{display:grid;\n grid-template-columns:var(--ss-mcols,100px 80px minmax(115px,1fr) minmax(125px,1.1fr) 70px 80px 85px 70px 75px minmax(110px,1fr));\n gap:10px;align-items:center;padding:5px 0}\n.ss-mhead{font-size:11px;font-weight:600;color:var(--el-text-color-secondary);\n border-bottom:1px solid var(--el-border-color-light)}\n.ss-mrow{border-bottom:1px dashed var(--el-border-color-lighter)}\n.ss-mrow:hover{background:var(--el-fill-color-light)}\n.ss-ell{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.ss-in{color:var(--el-color-success)}\n.ss-out{color:var(--el-color-danger)}\n.ss-name{font-weight:600;color:var(--el-text-color-primary)}\n.ss-sub{color:var(--el-text-color-secondary);font-size:11px;margin-top:2px;display:flex;align-items:center;gap:6px}\n.ss-c-num{text-align:right;font-variant-numeric:tabular-nums}\n.ss-strong{font-weight:700;color:var(--el-text-color-primary)}\n/* หน่วยอยู่ใต้ตัวเลข ไม่ต่อท้าย — เลขยาวๆ กับหน่วยติดกันอ่านยาก */\n.ss-unit{display:block;font-weight:400;color:var(--el-text-color-secondary);font-size:11px;margin-top:1px}\n.ss-dim{color:var(--el-text-color-placeholder)}\n.ss-order{color:var(--el-color-primary)}\n.ss-track{position:relative;height:6px;border-radius:3px;background:var(--el-fill-color-darker);overflow:hidden}\n.ss-fill{position:absolute;left:0;top:0;bottom:0;border-radius:3px}\n.ss-f-danger{background:var(--el-color-danger)}\n.ss-f-warning{background:var(--el-color-warning)}\n.ss-f-info{background:var(--el-color-info)}\n.ss-f-success{background:var(--el-color-success)}\n/* เส้นจุดสั่งซื้อ — สีส้มทึบให้เห็นชัดบนแถบทุกสี (เทาจางกลืนไปกับแถบเขียว) */\n.ss-min{position:absolute;top:-2px;bottom:-2px;width:2px;background:var(--el-color-warning)}\n.ss-empty{padding:24px;text-align:center;color:var(--el-text-color-secondary)}\n.ss-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 10px 0;flex-wrap:wrap}\n\n/* กล่องยืนยันสร้างใบเบิก — ทุกสีมาจาก el token ตามธีมเอง */\n.ss-mk-wait{padding:18px 4px;color:var(--el-text-color-secondary);font-size:13px}\n.ss-mk-doc{border:1px solid var(--el-border-color-light);border-radius:6px;padding:8px 10px;margin-top:8px;background:var(--el-fill-color-blank)}\n.ss-mk-route{display:flex;align-items:center;gap:6px;flex-wrap:wrap}\n.ss-mk-arrow{color:var(--el-text-color-secondary)}\n.ss-mk-meta{margin-left:auto;font-size:12px;color:var(--el-text-color-secondary)}\n.ss-mk-items{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}\n.ss-mk-item{font-size:12px;color:var(--el-text-color-regular);background:var(--el-fill-color-light);border-radius:4px;padding:1px 6px}\n.ss-mk-skips{margin-top:12px;border-top:1px dashed var(--el-border-color);padding-top:8px}\n.ss-mk-skiph{font-size:12px;font-weight:600;color:var(--el-color-warning);margin-bottom:4px}\n.ss-mk-skip{font-size:12px;color:var(--el-text-color-secondary);line-height:1.6}\n.ss-mk-act{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}\n/* จอแคบ: ทิ้งคอลัมน์ที่อนุมานเองได้ เหลือของที่ต้องตัดสินใจ */\n@media (max-width:900px){\n .ss-lhead{display:none}\n .ss-lrow{grid-template-columns:1fr 1fr;gap:2px 10px}\n .ss-mhead{display:none}\n .ss-mrow{grid-template-columns:1fr 1fr;gap:2px 10px}\n .ss-head{display:none}\n .ss-row{grid-template-columns:1fr auto;gap:4px 10px}\n .ss-c-num,.ss-c-level{text-align:left}\n .ss-q,.ss-loc{width:100%}\n}\n\n\n\n\n\n.sd-wrap{font-size:13px}\n.sd-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}\n/* el-button ที่อยู่ติดกันมี margin-left ของตัวเองอีก 12px ซ้อนกับ gap ของแถบ */\n.sd-bar .el-button+.el-button{margin-left:0}\n.sd-q{width:240px}\n.sd-type{width:150px}\n.sd-loc{width:140px}\n.sd-date{width:140px}\n.sd-time{color:var(--el-text-color-secondary);font-size:12px;margin-left:auto}\n/* แท็บสถานะ — เส้นใต้บอกตัวที่เลือก (ตารางอยู่ในกล่องอยู่แล้ว ไม่ต้องมีกรอบซ้อน) */\n.sd-tabs{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:10px;\n border-bottom:1px solid var(--el-border-color-light)}\n.sd-tab{padding:5px 0 8px;cursor:pointer;font-size:12px;font-weight:600;\n color:var(--el-text-color-secondary);border-bottom:2px solid transparent;margin-bottom:-1px;\n display:flex;align-items:center;gap:5px;user-select:none}\n.sd-tab:hover{color:var(--el-text-color-primary)}\n.sd-tabon{color:var(--el-color-primary);border-bottom-color:var(--el-color-primary)}\n.sd-badge{background:var(--el-fill-color-dark);color:var(--el-text-color-regular);\n border-radius:9px;padding:0 6px;font-size:11px;line-height:16px;min-width:16px;text-align:center}\n.sd-tabon .sd-badge{background:var(--el-color-primary);color:var(--el-color-white)}\n.sd-alert{margin-bottom:10px}\n.sd-head,.sd-row{display:grid;\n grid-template-columns:minmax(150px,1.5fr) minmax(110px,1fr) minmax(130px,1.2fr) 80px minmax(120px,1fr) minmax(200px,1.6fr);\n gap:10px;align-items:center;padding:8px 10px}\n.sd-head{font-size:12px;font-weight:600;color:var(--el-text-color-secondary);\n border-bottom:1px solid var(--el-border-color);text-transform:uppercase;letter-spacing:.03em}\n.sd-row{border-bottom:1px solid var(--el-border-color-lighter)}\n.sd-row:hover{background:var(--el-fill-color-light)}\n/* กำลังโหลดชุดใหม่ — แถวเดิมยังอยู่ให้อ่านต่อได้ แต่จางลงเพื่อบอกว่ากำลังจะเปลี่ยน\n   (ล้างตารางทิ้งทุกครั้งที่สลับแท็บ = จอกระพริบ อ่านยากกว่า) */\n.sd-stale{opacity:.45;pointer-events:none}\n.sd-no{font-weight:600;color:var(--el-color-primary);cursor:pointer}\n.sd-no:hover{text-decoration:underline}\n.sd-sub{color:var(--el-text-color-secondary);font-size:11px;margin-top:2px}\n.sd-type-t{color:var(--el-text-color-primary)}\n.sd-route{display:flex;align-items:center;gap:6px;flex-wrap:wrap}\n/* รหัสคลังเป็นตัวที่คนจำ (พิมพ์ค้นหา/พูดกัน) — ชื่อเต็มตามหลังไว้กันจำรหัสไม่ได้ */\n.sd-loc-item{display:inline-flex;align-items:baseline;gap:5px;min-width:0}\n.sd-loc-t{background:var(--el-fill-color-light);border-radius:4px;padding:1px 6px;font-size:12px;flex:none}\n.sd-loc-n{color:var(--el-text-color-secondary);font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.sd-arrow{color:var(--el-text-color-secondary)}\n.sd-num{text-align:right;font-variant-numeric:tabular-nums}\n/* จำนวนรายการคือตัวที่คนสแกนหา — จำนวนรวมเป็นข้อมูลรอง ต้องจางกว่าชัดเจน */\n.sd-items{color:var(--el-text-color-primary)}\n.sd-qty{text-align:right;cursor:help}\n.sd-dim{color:var(--el-text-color-placeholder)}\n/* ปุ่ม action ต่อแถว — ตัดระยะ margin ของ el-button ออก ใช้ gap คุมแทน */\n.sd-acts{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}\n.sd-acts .el-button+.el-button{margin-left:0}\n/* ข้อความแทนปุ่มที่ยังกดไม่ได้ — จางกว่าปุ่มชัดเจน ไม่ให้ดูเหมือนของที่คลิกได้ */\n.sd-hint{align-self:center;font-size:11px;color:var(--el-text-color-placeholder);font-style:italic}\n.sd-empty{padding:24px;text-align:center;color:var(--el-text-color-secondary)}\n.sd-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 10px 0;flex-wrap:wrap}\n.sd-dlg-act{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}\n.sd-mb{margin-bottom:6px}\n.sd-post-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}\n.sd-lhead,.sd-lrow{display:grid;grid-template-columns:minmax(140px,1.6fr) 90px 90px 130px;\n gap:10px;align-items:center;padding:6px 0}\n.sd-lhead{font-size:11px;font-weight:600;color:var(--el-text-color-secondary);\n border-bottom:1px solid var(--el-border-color-light);text-transform:uppercase;letter-spacing:.03em}\n.sd-lrow{border-bottom:1px dashed var(--el-border-color-lighter)}\n.sd-name{font-weight:600;color:var(--el-text-color-primary)}\n.sd-recv{width:120px}\n.sd-warn{margin-top:10px;padding:8px 10px;border-radius:6px;font-size:12px;\n background:var(--el-color-warning-light-9);color:var(--el-color-warning);\n border:1px solid var(--el-color-warning-light-7)}\n/* จอแคบ: ยุบเป็น 2 คอลัมน์ ทิ้งหัวตาราง (อ่านจากป้ายในแถวแทน) */\n@media (max-width:1000px){\n .sd-head{display:none}\n .sd-row{grid-template-columns:1fr 1fr;gap:4px 10px}\n .sd-num,.sd-acts{text-align:left;justify-content:flex-start}\n .sd-lhead{display:none}\n .sd-lrow{grid-template-columns:1fr 1fr;gap:2px 10px}\n .sd-q,.sd-type,.sd-loc,.sd-date{width:100%}\n}\n\n\n",
