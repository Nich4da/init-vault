                "content": "<div class=\"ss-wrap\">\n\n  <div class=\"ss-bar\">\n    <el-input :model-value=\"fQ\" @input=\"setQ\" @keyup.enter=\"reload()\" @clear=\"reload()\"\n      placeholder=\"Search code / name / synonym\" size=\"small\" clearable class=\"ss-q\" />\n    <el-select :model-value=\"fLoc\" @change=\"setLoc\" placeholder=\"All locations\" size=\"small\" clearable class=\"ss-loc\">\n      <el-option v-for=\"l in locList\" :key=\"l\" :label=\"l\" :value=\"l\" />\n    </el-select>\n    <el-button size=\"small\" type=\"primary\" :loading=\"loading\" @click=\"reload()\">Search</el-button>\n    <el-button v-if=\"mkLinked && mkCanRun()\" size=\"small\" type=\"warning\" plain :loading=\"mkBusy && !mkOpen\"\n      @click=\"mkPreview()\">Create requisition</el-button>\n    <sd-report :report-list=\"[{ reportId: '6a6f0667361d4f8b4f0d3850', label: 'Balance', type: 'pdf' }, { reportId: '6a6f0667361d4f8b4f0d3850', label: 'Balance (Excel)', type: 'excel' }]\"\n      :params=\"{ loc: fLoc }\" size=\"small\"></sd-report>\n    <span class=\"ss-time\" v-if=\"asOf\">ข้อมูล ณ {{ thDate(asOf) }}</span>\n  </div>\n\n  <el-dialog :model-value=\"mkOpen\" @close=\"mkClose()\" width=\"620px\" append-to-body destroy-on-close\n    title=\"Create requisition from low stock\">\n    <el-alert v-if=\"mkErr\" :title=\"mkErr\" type=\"error\" :closable=\"false\" show-icon class=\"ss-alert\" />\n    <div v-if=\"mkBusy\" class=\"ss-mk-wait\">Working…</div>\n    <div v-else-if=\"mkData\">\n      <el-alert :title=\"mkData.message\" :type=\"mkDone ? 'success' : 'info'\" :closable=\"false\" show-icon class=\"ss-alert\" />\n\n      <div v-for=\"c in mkData.created\" :key=\"c.location_to\" class=\"ss-mk-doc\">\n        <div class=\"ss-mk-route\">\n          <el-tag :type=\"c.move_type === 'RECEIVE' ? 'success' : 'warning'\" size=\"small\" effect=\"plain\">\n            {{ c.move_type === 'RECEIVE' ? 'Receive' : 'Requisition' }}\n          </el-tag>\n          <el-tag v-if=\"c.location_from\"