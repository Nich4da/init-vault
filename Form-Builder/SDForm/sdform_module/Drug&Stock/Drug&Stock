/div>\n\n  <el-alert v-if=\"errMsg\" :title=\"errMsg\" type=\"error\" :closable=\"false\" show-icon class=\"ss-alert\" />\n\n  <div class=\"ss-head\">\n    <div class=\"ss-c-item\">Item</div>\n    <div class=\"ss-c-loc\">Location</div>\n    <div class=\"ss-c-num\">On hand</div>\n    <div class=\"ss-c-num\">Incoming</div>\n    <div class=\"ss-c-num\">Available</div>\n    <div class=\"ss-c-level\">Min / Max</div>\n    <div class=\"ss-c-num\">To order</div>\n  </div>\n\n  <div v-for=\"r in rows\" :key=\"r.item_code + '@' + r.location\">\n  <div class=\"ss-row\" :class=\"{ 'ss-open': isOpen(r) }\" @click=\"toggleLot(r)\">\n    <div class=\"ss-c-item\">\n      <div class=\"ss-name\">\n        <span class=\"ss-caret\">{{ isOpen(r) ? '▾' : '▸' }}</span>\n        {{ r.item_name }}\n      </div>\n      <div class=\"ss-sub ss-indent\">\n        {{ r.item_code }}\n        <span class=\"ss-lotn\" v-if=\"r.lot_count > 0\">(Lots: {{ r.lot_count }})</span>\n        <el-tag v-if=\"r.expired_qty > 0\" type=\"danger\" size=\"small\" effect=\"plain\">expired {{ fmt(r.expired_qty) }}</el-tag>\n      </div>\n    </div>\n    <div class=\"ss-c-loc\">\n      <el-tag :type=\"tone(r.status)\" size=\"small\" effect=\"dark\">{{ r.location }}</el-tag>\n      <div class=\"ss-sub\">{{ r.location_name }}</div>\n    </div>\n    <div class=\"ss-c-num\">{{ fmt(r.on_hand) }}</div>\n    <div class=\"ss-c-num ss-dim\">{{ r.incoming > 0 ? '+' + fmt(r.incoming) : '—' }}</div>\n    <div class=\"ss-c-num ss-strong\">\n      {{ fmt(r.available) }}\n      <div class=\"ss-unit\" v-if=\"r.disp_unit\">{{ r.disp_unit }}</div>\n    </div>\n    <div class=\"ss-c-level\">\n      <div class=\"ss-track\">\n        <div class=\"ss-fill\" :class=\"'ss-f-' + tone(r.status)\" :style=\"{ width: barPct(r) + '%' }\"></div>\n        <div class=\"ss-min\" :style=\"{ left: minPct(r) + '%' }\"></div>\n      </div>\n      <div class=\"ss-sub\">{{ fmt(r.min_qty) }} / {{ fmt(r.max_qty) }}</div>\n    </div>\n    <div class=\"ss-c-nu