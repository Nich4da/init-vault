              "options": {
                "name": "stock_docs",
                "columnSpan": 4,
                "hidden": false,
                "content": "<div class=\"sd-wrap\">\n\n  <div class=\"sd-bar\">\n    <el-input :model-value=\"fQ\" @input=\"setQ\" @keyup.enter=\"reload()\" @clear=\"reload()\"\n      placeholder=\"Search document no / ref / note\" size=\"small\" clearable class=\"sd-q\" />\n    <el-select :model-value=\"fType\" @change=\"setType\" placeholder=\"All types\" size=\"small\" clearable class=\"sd-type\">\n      <el-option v-for=\"t in typeList\" :key=\"t.v\" :label=\"t.t\" :value=\"t.v\" />\n    </el-select>\n    <el-select :model-value=\"fLoc\" @change=\"setLoc\" placeholder=\"All locations\" size=\"small\" clearable class=\"sd-loc\">\n      <el-option v-for=\"l in locList\" :key=\"l.code\" :label=\"l.label\" :value=\"l.code\" />\n    </el-select>\n    <sd-date-picker-be :model-value=\"fFrom\" @update:model-value=\"setFrom\" buddhist type=\"date\" placeholder=\"From\"\n      value-format=\"YYYY-MM-DD\" size=\"small\" class=\"sd-date\"></sd-date-picker-be>\n    <sd-date-picker-be :model-value=\"fTo\" @update:model-value=\"setTo\" buddhist type=\"date\" placeholder=\"To\"\n      value-format=\"YYYY-MM-DD\" size=\"small\" class=\"sd-date\"></sd-date-picker-be>\n    <el-button size=\"small\" type=\"primary\" :loading=\"loading\" @click=\"reload()\">Search</el-button>\n    <el-button size=\"small\" @click=\"clearFilters()\">Clear</el-button>\n    <el-button size=\"small\" type=\"success\" plain @click=\"newDoc()\">New document</el-button>\n    <span class=\"sd-time\" v-if=\"asOf\">ข้อมูล ณ {{ thDate(asOf) }}</span>\n  </div>\n\n  <div class=\"sd-tabs\">\n    <div v-for=\"t in tabs\" :key=\"t.key\" class=\"sd-tab\" :class=\"{ 'sd-tabon': isTab(t.key) }\" @click=\"setTab(t.key)\">\n      {{ t.label }}\n      <span class=\"sd-badge\" v-if=\"tabCount(t.key) > 0\">{{ tabCount(t.key) }}</span>\n    </div>\n  </div>\n\n  <el-alert v-if=\"errMsg\" :title=\"errMsg\" type=\"error\" :closable=\"false\" show-icon class=\"sd-alert\" />\n\n  <div class=\"sd-head\">\n    <div>Document</div>\n    <div>Type</div>\n    <div>Route</div>\n    <div class=\"sd-num\">Items</div>\n    <div>Status</div>\n    <div>Actions</div>\n  </div>\n\n  <div v-for=\"r in rows\" :key=\"r.doc_id\" class=\"sd-row\" :class=\"{ 'sd-stale': loading }\">\n    <div class=\"sd-doc\">\n      <a class=\"sd-no\" @click=\"openRow(r)\">{{ docLabel(r) }}</a>\n      <div class=\"sd-sub\">{{ thDay(r.doc_date) }} · {{ r.created_by || '—' }}</div>\n    </div>\n\n    <div>\n      <span class=\"sd-type-t\">{{ r.type_label }}</span>\n      <div class=\"sd-sub\" v-if=\"r.ref_doc\">ref {{ r.ref_doc }}</div>\n    </div>\n\n    <div class=\"sd-route\">\n      <span v-if=\"r.location_from\" class=\"sd-loc-item\">\n        <span class=\"sd-loc-t\">{{ r.location_from }}</span>\n        <span class=\"sd-loc-n\" v-if=\"r.location_from_name\">{{ r.location_from_name }}</span>\n      </span>\n      <span v-if=\"r.location_from && r.location_to\" class=\"sd-arrow\">→</span>\n      <span v-if=\"r.location_to\" class=\"sd-loc-item\">\n        <span class=\"sd-loc-t\">{{ r.location_to }}</span>\n        <span class=\"sd-loc-n\" v-if=\"r.location_to_name\">{{ r.location_to_name }}</span>\n      </span>\n      <span v-if=\"!r.location_from && !r.location_to\" class=\"sd-dim\">—</span>\n      <div class=\"sd-sub\" v-if=\"r.vendor\">{{ r.vendor }}</div>\n    </div>\n\n    <div class=\"sd-num\">\n      <div class=\"sd-items\">{{ itemText(r) }}</div>\n      <div class=\"sd-sub sd-qty\" v-if=\"r.line_qty\" :title=\"qtyTitle(r)\">{{ fmt(r.line_qty) }} units</div>\n    </div>\n\n    <div>\n      <el-tag :type=\"tone(r.doc_status)\" size=\"small\" effect=\"dark\">{{ r.status_label }}</el-tag>\n      <div class=\"sd-sub\" v-if=\"r.approved_by\">by {{ r.approved_by }}</div>\n      <div class=\"sd-sub\" v-else-if=\"r.requested_by\">by {{ r.requested_by }}</div>\n    </div>\n\n    <div class=\"sd-acts\">\n      <el-button v-if=\"canEdit(r)\" size=\"small\" plain type=\"primary\" @click=\"openDoc(r)\">Edit</el-button>\n      <el-button v-else size=\"small\" plain @click=\"viewDoc(r)\">View</el-button>\n      <el-button v-for=\"a in r.allowed_actions\" :key=\"a.action\" size=\"small\" plain\n        :type=\"a.action === 'approve' ? 'warning' : (a.action === 'cancel' ? 'danger' : (a.action === 'reject' ? 'info' : 'primary'))\"\n        :loading=\"rowBusy(r)\" @click=\"act(r, a)\">{{ a.label }}</el-button>\n      <el-button v-if=\"r.can_post\" size=\"small\" type=\"success\" :loading=\"rowBusy(r)\" @click=\"postAsk(r)\">\n        {{ r.post_leg === 'receive' ? 'Receive' : (r.post_leg === 'ship' ? 'Ship' : 'Post') }}\n      </el-button>\n      <sd-report :report-list=\"[{ reportId: '6a6f043c23e91f1643af7acd', label: 'Print', type: 'pdf' }]\"\n        :params=\"{ doc_id: r.doc_id }\" size=\"small\"></sd-report>\n      <span v-if=\"hintText(r)\" class=\"sd-hint\" :title=\"hintText(r)\">{{ hintText(r) }}</span>\n    </div>\n  </div>\n\n  <div v-if=\"loading && !rows.length\" class=\"sd-empty\">Loading…</div>\n  <div v-else-if=\"!loading && rows.length === 0\" class=\"sd-empty\">\n    {{ fQ || fType || fLoc || fFrom || fTo ? 'No document matches these filters.' : 'No document in this tab.' }}\n  </div>\n\n  <div class=\"sd-foot\" v-if=\"total > 0\">\n    <span class=\"sd-sub\">{{ rangeText() }}</span>\n    <el-pagination v-if=\"pageCount() > 1\" layout=\"prev, pager, next\" background small\n      :current-page=\"page\" :page-size=\"pageSize\" :total=\"total\" @current-change=\"goPage\" />\n  </div>\n\n  <el-dialog :model-value=\"noteOpen\" @close=\"noteClose()\" width=\"480px\" append-to-body destroy-on-close\n    :title=\"noteTitle()\">\n    <div class=\"sd-sub sd-mb\">The requester will see this reason.</div>\n    <el-input :model-value=\"noteText\" @input=\"setNote\" type=\"textarea\" :rows=\"3\" placeholder=\"Reason\" />\n    <div class=\"sd-dlg-act\">\n      <el-button size=\"small\" @click=\"noteClose()\">Cancel</el-button>\n      <el-button size=\"small\" type=\"primary\" @click=\"noteConfirm()\">Confirm</el-button>\n    </div>\n  </el-dialog>\n\n  <el-dialog :model-value=\"postOpen\" @close=\"postClose()\" width=\"640px\" append-to-body destroy-on-close\n    title=\"Post to stock\">\n    <div v-if=\"postRow\">\n      <div class=\"sd-post-head\">\n        <b>{{ docLabel(postRow) }}</b>\n        <span class=\"sd-type-t\">{{ postRow.type_label }}</span>\n        <span v-if=\"postRow.location_from\" class=\"sd-loc-t\">{{ postRow.location_from }}</span>\n        <span v-if=\"postRow.location_from && postRow.location_to\" class=\"sd-arrow\">→</span>\n        <span v-if=\"postRow.location_to\" class=\"sd-loc-t\">{{ postRow.location_to }}</span>\n      </div>\n      <el-alert :title=\"legText(postRow)\" type=\"info\" :closable=\"false\" show-icon class=\"sd-alert\" />\n      <el-alert v-if=\"postErr\" :title=\"postErr\" type=\"error\" :closable=\"false\" show-icon class=\"sd-alert\" />\n\n      <div v-if=\"postRow.post_leg === 'receive'\">\n        <div v-if=\"postBusy && !postLines.length\" class=\"sd-empty\">Loading lines…</div>\n        <div v-else-if=\"postLines.length\">\n          <div class=\"sd-lhead\">\n            <div>Item</div>\n            <div class=\"sd-num\">Shipped</div>\n            <div class=\"sd-num\">In transit</div>\n            <div class=\"sd-num\">Received</div>\n          </div>\n          <div v-for=\"ln in postLines\" :key=\"ln.seq\" class=\"sd-lrow\">\n            <div>\n              <div class=\"sd-name\">{{ ln.item_name || ln.item_code }}</div>\n              <div class=\"sd-sub\">{{ ln.item_code }}<span v-if=\"ln.disp_unit\"> · {{ ln.disp_unit }}</span></div>\n            </div>\n            <div class=\"sd-num\">{{ fmt(ln.qty_input) }}</div>\n            <div class=\"sd-num sd-dim\">{{ fmt(ln.transit_qty) }}</div>\n            <div class=\"sd-num\">\n              <el-input-number :model-value=\"ln.recv\" @change=\"(v) => setRecv(ln, v)\" :min=\"0\" :max=\"ln.qty_input\"\n                size=\"small\" controls-position=\"right\" class=\"sd-recv\" />\n            </div>\n          </div>\n          <div v-if=\"postShort() > 0\" class=\"sd-warn\">\n            {{ postShort() }} lines short — the remainder stays in TRANSIT until it is returned or received later.\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"sd-dlg-act\">\n      <el-button size=\"small\" @click=\"postClose()\">Cancel</el-button>\n      <el-button size=\"small\" type=\"success\" :loading=\"postBusy\" @click=\"postConfirm()\">Post</el-button>\n    </div>\n  </el-dialog>\n</div>\n",
                "customClass": "",
                "onCreated": "const s = this.vueState;\nconst field = this;\n\ns.rows = [];\ns.loading = false;\ns.errMsg = null;\ns.asOf = null;\ns.total = 0;\ns.page = 1;\ns.pageSize = 25;\ns.summary = { by_status: {}, open: 0, all: 0 };\n// ตัวเลือกคลัง — API ส่งมาจากทะเบียนคลังจริง (ไม่ใช่เก็บจากแถวที่โหลดมา ซึ่งจะได้ไม่ครบ)\n// label ประกอบเหมือนช่อง Location ในฟอร์มใบ: 'MAIN1 คลังยาหลัก'\ns.locList = [];\n\n// เปิดจอมาเห็น \"ใบที่ยังต้องมีคนไปทำอะไรต่อ\" ก่อน — ใบที่จบแล้วไม่ใช่งานของวันนี้\ns.fStatus = 'open';\ns.fType = '';\ns.fLoc = '';\ns.fQ = '';\ns.fFrom = '';\ns.fTo = '';\n\n// แท็บสถานะ — เรียงตามลำดับที่ใบเดินจริง ไม่ใช่เรียงตามความถี่\ns.tabs = [\n  { key: 'open', label: 'To do' },\n  { key: 'draft', label: 'Draft' },\n  { key: 'requested', label: 'Waiting approval' },\n  { key: 'approved', label: 'Approved' },\n  { key: 'in_transit', label: 'In transit' },\n  { key: 'completed', label: 'Completed' },\n  { key: 'cancelled', label: 'Cancelled' },\n  { key: 'all', label: 'All' },\n];\n\n// ชนิดใบ — ป้ายชุดเดียวกับ dropdown ในฟอร์มใบ (gen/move-types.cjs)\ns.typeList = [{\"v\":\"OPENING\",\"t\":\"Opening — ยอดยกมา (ตั้งต้น)\"},{\"v\":\"RECEIVE\",\"t\":\"Receive — รับเข้า (จัดซื้อ)\"},{\"v\":\"RECEIVE_MADE\",\"t\":\"Receive Made — รับยาผลิต\"},{\"v\":\"RECEIVE_OTHER\",\"t\":\"Receive Other — รับบริจาค/ตัวอย่าง\"},{\"v\":\"REQUISITION\",\"t\":\"Requisition — เบิก (ปลายทางขอ)\"},{\"v\":\"TRANSFER\",\"t\":\"Transfer — โอน (ต้นทางส่ง)\"},{\"v\":\"ISSUE_USE\",\"t\":\"Issue Use — เบิกใช้ภายใน\"},{\"v\":\"ADJUST\",\"t\":\"Adjust — ปรับยอด (นับสต็อก)\"},{\"v\":\"DESTROY\",\"t\":\"Destroy — ตัดทำลาย\"},{\"v\":\"REVERSAL\",\"t\":\"Reversal — กลับรายการ\"},{\"v\":\"TRANSIT_RETURN\",\"t\":\"Transit Return — คืนของค้างคลังพัก\"}];\n\n// 🔴 ใช้ globalUserState ไม่ใช่ getFormRef().userState\n//    getFormRef() เป็น null ใน App UI (SdAppViewer → SdCrudForm → async SdFormRender คั่นหลายชั้น)\n//    globalUserState = ตัวเดียวกันแต่ provide ตั้งแต่ created (SdFormRender.vue:300)\ns.api = () => field.globalUserState || (field.getFormRef() && field.getFormRef().userState) || null;\n\n// 🔴 ห้าม guard แบบ 'if (s.loading) return;' — เคยเขียนแบบนั้นแล้วเป็นบั๊ก:\n//    กดแท็บ Draft (ยังโหลดไม่เสร็จ) → กด Approved ทันที → ถูก return ทิ้งเงียบๆ\n//    ⇒ แท็บที่ไฮไลต์คือ Approved แต่ตารางยังเป็นข้อมูล Draft โดยไม่มีอะไรบอก\n//    จอนี้มีปุ่ม Approve/Post ติดอยู่กับแถว ⇒ กดผิดใบได้จริง\n// แทนที่ด้วยเลขรอบ: ยิงใหม่ได้เสมอ แต่รับเฉพาะผลของรอบล่าสุด (ผลเก่ามาทีหลังก็ทิ้ง)\ns.reqSeq = 0;\n\ns.load = () => {\n  const api = s.api();\n  if (!api || !api.runProcess) { s.errMsg = 'Cannot reach the API from this screen'; return; }\n  const seq = ++s.reqSeq;\n  s.loading = true;\n  s.errMsg = null;\n  api.runProcess(\n    '6a6e3f1027768b0ec5392414',\n    {\n      api_version: 1,\n      status: s.fStatus || 'all',\n      move_type: s.fType || '',\n      location: s.fLoc || '',\n      q: s.fQ || '',\n      date_from: s.fFrom || '',\n      date_to: s.fTo || '',\n      limit: s.pageSize,\n      skip: (s.page - 1) * s.pageSize,\n    },\n    (res) => {\n      if (seq !== s.reqSeq) return;   // มีคนกดแท็บ/ค้นหาใหม่ไปแล้ว — ผลรอบนี้ล้าสมัย ทิ้ง\n      s.loading = false;\n      const r = (res && res.data) || {};\n      if (!r.ok) { s.errMsg = r.message || 'Unable to load documents'; return; }\n      s.rows = r.rows || [];\n      s.total = Number(r.total) || 0;\n      s.summary = r.summary || { by_status: {}, open: 0, all: 0 };\n      s.asOf = r.as_of || null;\n      if (r.locations && r.locations.length) s.locList = r.locations;\n    },\n    (err) => {\n      if (seq !== s.reqSeq) return;\n      s.loading = false;\n      s.errMsg = (err && err.message) ? err.message : 'Unable to load documents';\n    },\n  );\n};\n\n// เปลี่ยนเงื่อนไขต้องกลับหน้า 1 เสมอ — ไม่งั้นค้างอยู่หน้า 5 ของผลที่มี 2 หน้า = จอว่างทั้งที่มีข้อมูล\ns.reload = () => { s.page = 1; s.load(); };\ns.goPage = (p) => { s.page = p; s.load(); };\ns.pageCount = () => Math.max(1, Math.ceil((s.total || 0) / s.pageSize));\ns.rangeText = () => {\n  if (!s.total) return '0';\n  const from = (s.page - 1) * s.pageSize + 1;\n  return from + '–' + Math.min(s.total, from + s.rows.length - 1) + ' / ' + s.total;\n};\n\n// 🔴 ห้าม v-model กับค่าใน vueState — scope proxy มีแต่ trap get/has (ไม่มี set)\n//    เขียนกลับจะหลุดไปลง target เปล่า แล้ว template พังเป็น error box ทั้ง widget\n//    ทุกช่องกรอกจึงเป็น :model-value + @change/@input เรียก setter ที่ normalize เอง\ns.setTab = (k) => { s.fStatus = k; s.reload(); };\ns.setType = (v) => { s.fType = v || ''; s.reload(); };\ns.setLoc = (v) => { s.fLoc = v || ''; s.reload(); };\ns.setQ = (v) => { s.fQ = v == null ? '' : String(v); };\ns.setFrom = (v) => { s.fFrom = v || ''; s.reload(); };\ns.setTo = (v) => { s.fTo = v || ''; s.reload(); };\ns.clearFilters = () => { s.fType = ''; s.fLoc = ''; s.fQ = ''; s.fFrom = ''; s.fTo = ''; s.reload(); };\ns.isTab = (k) => s.fStatus === k;\n\n// ตัวเลขบนแท็บ — มาจาก summary ซึ่งนับโดยไม่สนแท็บที่เลือกอยู่ (ดู stock-doc-view)\ns.tabCount = (k) => {\n  if (k === 'all') return s.summary.all || 0;\n  if (k === 'open') return s.summary.open || 0;\n  return (s.summary.by_status && s.summary.by_status[k]) || 0;\n};\n\n// สีของสถานะ — ต้องสื่อ \"ต้องทำอะไรต่อไหม\" ไม่ใช่แค่ ok/fail\n//   warning = รอคนมากด · primary = ของกำลังเดินทาง · success = จบ · info = จบแบบไม่มีผล\ns.tone = (st) => {\n  if (st === 'draft') return 'info';\n  if (st === 'requested') return 'warning';\n  if (st === 'approved') return 'primary';\n  if (st === 'in_transit') return 'primary';\n  if (st === 'completed') return 'success';\n  if (st === 'partial') return 'warning';\n  if (st === 'cancelled' || st === 'reversed') return 'info';\n  return 'info';\n};\n\n// ใบร่างยังไม่มีเลขที่ (ออกเลขตอน post) — โชว์ช่องว่างจะดูเหมือนข้อมูลหาย\ns.docLabel = (r) => r.doc_no || '(no number yet)';\n\ns.fmt = (n) => {\n  const v = Number(n) || 0;\n  return v % 1 === 0 ? String(v) : String(Math.round(v * 100) / 100);\n};\n\n// คอลัมน์ Items เคยโชว์เลขลอย 2 ตัวซ้อนกัน (1 / 990) — อ่านไม่ออกว่าตัวไหนคืออะไร\n// ⇒ ติดคำกำกับทั้งคู่ แล้วบอกหน่วยที่ใบใช้ไว้ใน tooltip (จำนวนคนละหน่วยรวมกันไม่ได้ ต้องรู้ว่านับด้วยอะไร)\ns.itemText = (r) => {\n  const n = Number(r.line_count) || 0;\n  return n + (n === 1 ? ' item' : ' items');\n};\ns.unitMode = (r) => {\n  const m = r.qty_unit_mode || 'purchase';\n  if (m === 'disp') return 'dispense unit';\n  if (m === 'pack') return 'pack unit';\n  return 'purchase unit';\n};\ns.qtyTitle = (r) => 'Total ' + s.fmt(r.line_qty) + ' in ' + s.unitMode(r) + ' (as entered on the document)';\n\n// 'YYYY-MM-DD HH:mm:ss' → 'DD/MM/BBBB HH:mm น.' (พ.ศ.)\ns.thDate = (v) => {\n  if (!v) return '';\n  const p = String(v).split(' ');\n  const d = (p[0] || '').split('-');\n  if (d.length !== 3) return String(v);\n  const time = (p[1] || '').slice(0, 5);\n  return d[2] + '/' + d[1] + '/' + (Number(d[0]) + 543) + (time ? ' ' + time + ' น.' : '');\n};\ns.thDay = (v) => {\n  if (!v) return '';\n  const d = String(v).slice(0, 10).split('-');\n  if (d.length !== 3) return String(v);\n  return d[2] + '/' + d[1] + '/' + (Number(d[0]) + 543);\n};\n\n// ── เปิด/สร้างใบ ────────────────────────────────────────────────────────────\n// openForm มีเฉพาะบน SdFormRender — ใน App UI อาจไม่มี ให้บอกผู้ใช้ตรงๆ แทนที่จะเงียบ\n// เปิดใบ — ใบร่างแก้ได้ ใบอื่นเปิดดูได้อย่างเดียว\n// 🔴 ตัวล็อกจริงอยู่ในฟอร์ม (DOC_LOCK validator) ไม่ใช่ที่จอนี้ — จอแค่ไม่ชวนให้กดแก้\n//    (กันคนเปิดใบที่อนุมัติแล้วมาแก้ของ แล้วเจอ error ตอน save ซึ่งสายไปแล้ว)\ns.openDoc = (r) => {\n  const form = field.getFormRef();\n  if (!form || !form.openForm) {\n    field.alert('Open the Stock Documents screen to view ' + s.docLabel(r) + '.', 'info', 6000);\n    return;\n  }\n  form.openForm('6a6ac182c91cb8030e26d7d5', r.doc_id, '', {}, {\n    afterSaveCallback: () => {\n      if (form.closePopupForm) form.closePopupForm();\n      s.load();\n    },\n  });\n};\n\n// ปุ่ม Edit = ทางเดียวกับคลิกเลขที่ใบ แต่ขึ้นเฉพาะใบร่าง — ให้เห็นชัดว่าใบไหน \"ยังแก้ได้\"\n// (เลขที่ใบยังคลิกได้ทุกสถานะ เพราะบางทีต้องเปิดดูใบที่ปิดไปแล้ว)\ns.canEdit = (r) => !r.is_locked;\n\n// เปิดดูอย่างเดียว — คนอนุมัติต้องเห็นรายการยาก่อนกด Approve และใบที่ปิดแล้วก็ต้องเปิดย้อนดูได้\n// readonly ส่งต่อไปถึง SdCrudForm → :disabled ครอบทั้งฟอร์ม + ซ่อนปุ่ม Save ให้เอง\n//   (ต่างจากการเปิดปกติที่ DOC_LOCK บล็อกตอน save — ผู้ใช้พิมพ์ไปทั้งใบแล้วเพิ่งรู้ว่าแก้ไม่ได้)\ns.viewDoc = (r) => {\n  const form = field.getFormRef();\n  if (!form || !form.openForm) {\n    field.alert('Open the Stock Documents screen to view ' + s.docLabel(r) + '.', 'info', 6000);\n    return;\n  }\n  form.openForm('6a6ac182c91cb8030e26d7d5', r.doc_id, '', {}, { readonly: true });\n};\n\n// คลิกเลขที่ใบ = เหมือนกดปุ่มในแถวนั้น (ใบร่างแก้ได้ · ใบอื่นเปิดดู) — สองทางต้องไม่พาไปคนละที่\ns.openRow = (r) => (s.canEdit(r) ? s.openDoc(r) : s.viewDoc(r));\n\n// เหตุผลที่ปุ่ม Post ไม่ขึ้น — ข้อความสั้นแทนปุ่ม ไม่ใช่ปล่อยว่าง\n// ซ่อนเฉยๆ ผู้ใช้จะงงว่าใบนี้ต่างจากใบอื่นตรงไหน แล้วเปิดเข้าไปดูเองทีละใบ\ns.hintText = (r) => {\n  const h = r.post_hint;\n  if (!h) return '';\n  if (h === 'needs_approval') return 'needs approval first';\n  if (h === 'no_lines') return 'no items yet';\n  if (h === 'no_ref_doc') return 'pick the source document first';\n  if (h === 'type_not_enabled') return 'this type is not enabled yet';\n  return '';\n};\n\ns.newDoc = () => {\n  const form = field.getFormRef();\n  if (!form || !form.openForm) {\n    field.alert('Open the Stock Documents screen to create a new document.', 'info', 6000);\n    return;\n  }\n  form.openForm('6a6ac182c91cb8030e26d7d5', '', '', {}, {\n    afterSaveCallback: () => {\n      if (form.closePopupForm) form.closePopupForm();\n      s.load();\n    },\n  });\n};\n\n// ── ปุ่ม action (Send / Approve / Reject / Cancel) ───────────────────────────\n// สถานะใบเปลี่ยนผ่าน stock-doc-action เท่านั้น — จอห้ามเขียน doc_status เอง\n// (guard ข้ามขั้น / สิทธิ์ / กันสองคนกดพร้อมกัน อยู่ฝั่ง server ทั้งหมด)\ns.busyId = '';        // ใบที่กำลังยิง action อยู่ — กันกดรัวใบเดิม\ns.noteOpen = false;\ns.noteText = '';\ns.noteRow = null;\ns.noteAct = null;\n\ns.setNote = (v) => { s.noteText = v == null ? '' : String(v); };\ns.noteClose = () => { s.noteOpen = false; s.noteRow = null; s.noteAct = null; s.noteText = ''; };\ns.noteTitle = () => (s.noteAct ? s.noteAct.label + ' ' + s.docLabel(s.noteRow || {}) : '');\n\n// action ที่ย้อนงานของคนอื่น (reject/cancel) ต้องกรอกเหตุผลก่อน — API บังคับอยู่แล้ว\n// จอถามก่อนเพื่อไม่ให้ผู้ใช้เจอ error แล้วต้องกดใหม่\ns.act = (r, a) => {\n  if (a.require_note) {\n    s.noteRow = r;\n    s.noteAct = a;\n    s.noteText = '';\n    s.noteOpen = true;\n    return;\n  }\n  s.runAct(r, a, '');\n};\n\ns.noteConfirm = () => {\n  if (!s.noteText || !s.noteText.trim()) {\n    field.alert('Reason is required.', 'warning');\n    return;\n  }\n  const r = s.noteRow, a = s.noteAct, note = s.noteText;\n  s.noteClose();\n  s.runAct(r, a, note);\n};\n\ns.runAct = (r, a, note) => {\n  const api = s.api();\n  if (!api || !api.runProcess) { field.alert('Cannot reach the API from this screen', 'error'); return; }\n  if (s.busyId) return;\n  s.busyId = r.doc_id;\n  api.runProcess(\n    '6a6bcf8e265885c2377cc11f',\n    { api_version: 1, doc_id: r.doc_id, action: a.action, note: note || '' },\n    (res) => {\n      s.busyId = '';\n      const d = (res && res.data) || {};\n      field.alert(d.message || (d.ok ? a.label + ' done' : a.label + ' failed'), d.ok ? 'success' : 'error', d.ok ? 4000 : 8000);\n      // 🔴 โหลดใหม่เสมอ แม้ทำไม่สำเร็จ — ที่ล้มเหลวมักเพราะคนอื่นเพิ่งเปลี่ยนสถานะใบไปแล้ว\n      //    จอที่ยังโชว์ของเก่าจะทำให้กดผิดซ้ำอีก\n      s.load();\n    },\n    (err) => {\n      s.busyId = '';\n      field.alert(a.label + ' error: ' + ((err && err.message) || 'unknown'), 'error', 8000);\n    },\n  );\n};\n\n// ── ปุ่ม Post (คนละสายกับ 4 ปุ่มบน — ยิง stock-post ซึ่งแตะยอดจริง) ──────────\n// 2 จังหวะเสมอ: เปิดกล่องให้เห็นว่ากำลังจะลงบัญชีใบไหน/ขาไหน → ยืนยัน\n//   ขารับของใบเบิกต้องกรอกจำนวนที่รับจริงด้วย (รับไม่ครบไม่ใช่ error — ส่วนที่เหลือค้าง TRANSIT)\ns.postOpen = false;\ns.postRow = null;\ns.postBusy = false;\ns.postErr = '';\ns.postLines = [];     // [{ seq, item_code, item_name, disp_unit, qty_input, transit_qty, recv }]\n\ns.postAsk = (r) => {\n  s.postRow = r;\n  s.postErr = '';\n  s.postLines = [];\n  s.postOpen = true;\n  if (r.post_leg !== 'receive') return;   // ขาอื่นไม่ต้องกรอกจำนวน\n\n  // ขารับ: ขอรายการยาของใบนี้มากรอก (list ปกติไม่ส่ง lines มาเพราะใบ ADJUST มีเป็นร้อยบรรทัด)\n  const api = s.api();\n  if (!api || !api.runProcess) { s.postErr = 'Cannot reach the API from this screen'; return; }\n  s.postBusy = true;\n  api.runProcess(\n    '6a6e3f1027768b0ec5392414',\n    { api_version: 1, doc_id: r.doc_id, with_lines: true },\n    (res) => {\n      s.postBusy = false;\n      const d = (res && res.data) || {};\n      const row = (d.rows && d.rows[0]) || null;\n      if (!d.ok || !row) { s.postErr = d.message || 'Unable to load document lines'; return; }\n      // ค่าตั้งต้น = รับครบตามที่ส่ง (เคสปกติ) — ผู้ใช้แก้เฉพาะบรรทัดที่รับไม่ครบ\n      s.postLines = (row.lines || []).map((l) => ({\n        seq: l.seq, item_code: l.item_code, item_name: l.item_name, disp_unit: l.disp_unit,\n        qty_input: l.qty_input, transit_qty: l.transit_qty, recv: l.qty_input,\n      }));\n    },\n    (err) => {\n      s.postBusy = false;\n      s.postErr = (err && err.message) ? err.message : 'Unable to load document lines';\n    },\n  );\n};\n\ns.postClose = () => { s.postOpen = false; s.postRow = null; s.postLines = []; s.postErr = ''; };\n\n// จำนวนรับต้องเป็นตัวเลข ≥ 0 และไม่เกินที่ส่งมา — กรอกเกินคือของงอกจากอากาศ\ns.setRecv = (ln, v) => {\n  const n = Number(v);\n  if (v === '' || v === null || isNaN(n) || n < 0) { ln.recv = 0; return; }\n  ln.recv = Math.min(n, Number(ln.qty_input) || 0);\n};\n\ns.postShort = () => s.postLines.filter((l) => Number(l.recv) < Number(l.qty_input)).length;\n\ns.legText = (r) => {\n  if (!r) return '';\n  if (r.post_leg === 'ship') return 'Ship — stock leaves the source location';\n  if (r.post_leg === 'receive') return 'Receive — stock arrives at the destination';\n  return 'Post to stock';\n};\n\ns.postConfirm = () => {\n  const r = s.postRow;\n  if (!r || s.postBusy) return;\n  const api = s.api();\n  if (!api || !api.runProcess) { s.postErr = 'Cannot reach the API from this screen'; return; }\n  s.postBusy = true;\n  s.postErr = '';\n  const payload = { api_version: 1, doc_id: r.doc_id, source_system: 'FORM' };\n  // ส่ง receive_lines เฉพาะตอนรับไม่ครบ — ครบทุกบรรทัดไม่ต้องส่ง (API ถือว่ารับครบตามที่ส่ง)\n  if (r.post_leg === 'receive' && s.postShort() > 0) {\n    payload.receive_lines = s.postLines.map((l) => ({ seq: l.seq, qty: Number(l.recv) || 0 }));\n  }\n  api.runProcess(\n    '6a6aa48ec91cb8030e26d7d2',\n    payload,\n    (res) => {\n      s.postBusy = false;\n      const d = (res && res.data) || {};\n      if (!d.ok) { s.postErr = d.message || 'Post failed'; s.load(); return; }\n      // สีต้องตรงความหมาย ไม่ใช่ ok/fail แบบทวิภาค:\n      //   ฟ้า = ลงบัญชีแล้วแต่งานยังไม่จบ (ของอยู่คลังพัก รอปลายทางกดรับ)\n      //   ส้ม = จบแล้วแต่มีของค้างต้องตามปิด · เขียว = จบสมบูรณ์\n      let type = 'success';\n      if (d.doc_status === 'in_transit') type = 'primary';\n      else if (d.discrepancy && d.discrepancy.length) type = 'warning';\n      field.alert(d.message || 'Posted', type, type === 'success' ? 4000 : 8000);\n      s.postClose();\n      s.load();\n    },\n    (err) => {\n      s.postBusy = false;\n      s.postErr = 'Post error: ' + ((err && err.message) || 'unknown');\n    },\n  );\n};\n\ns.rowBusy = (r) => s.busyId === r.doc_id;\n",
