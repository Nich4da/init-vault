                "onCreated": "const s = this.vueState;\nconst field = this;\n\ns.rows = [];\ns.summary = { critical: 0, low: 0, ok: 0, over: 0 };\ns.loading = false;\ns.asOf = null;\ns.errMsg = null;\ns.total = 0;\ns.page = 1;\ns.pageSize = 50;\ns.locList = [];   // สะสมตัวเลือกคลังไว้ — กรองคลังแล้วผลเหลือคลังเดียว dropdown ต้องยังเลือกกลับได้\n\n// เงื่อนไขทั้งหมดส่งให้ server กรอง (ดูหัวไฟล์)\ns.fLoc = '';\ns.fQ = '';\ns.fStatus = ['critical', 'low'];   // เปิดจอมาเห็นเฉพาะตัวที่ต้องลงมือทำก่อน\n\n// ── สิทธิ์ลงมือทำ = หน่วยงานของคลัง (org_unit ใน Stock Locations) ────────────\n// จอนี้ \"ดูได้ทุกคน\" โดยตั้งใจ — คนนอกหน่วยมาเช็คของได้ แต่กดทำรายการไม่ได้ (พี่เคาะ 2026-08-02)\n//\n// 🔴 ใน onCreated อ้าง userInfo ตรงๆ ไม่ได้ (compile ด้วย argNames ว่าง = \"userInfo is not defined\")\n//    → globalUserState.user คือแหล่งเดียวกับ vueParams.userInfo และเป็น live ref\n//      สลับหน่วยแล้วค่าอัพเดตตาม ไม่ต้องรีเฟรชจอ\ns.myUnit = () => {\n  const u = field.globalUserState && field.globalUserState.user;\n  return (u && u.unit && u.unit.code) || '';\n};\n\n// เกณฑ์เดียวกับ ENFORCE_UNIT ที่ stock-post ใช้ — จอกับ server ต้องตอบตรงกัน\n//   คลังที่ org_unit ว่าง = คลังระบบ (TRANSIT) ไม่มีเจ้าของ → server ปล่อยผ่าน จอจึงต้องผ่านด้วย\n//   user ที่ยังไม่ผูกหน่วย (myUnit ว่าง) ทำอะไรไม่ได้เลย — ต้องสลับหน่วยก่อน\ns.canManage = (r) => {\n  const mine = s.myUnit();\n  if (!mine) return false;\n  return !r.org_unit || r.org_unit === mine;\n};\n\n// ปุ่มสร้างใบเบิกรวมยึด filter ที่จอเห็นอยู่ → ไม่มีคลังของหน่วยตัวเองในผลเลย = ไม่มีอะไรให้สร้าง\n// (server กันซ้ำอีกชั้นที่ stock-reorder-doc — ซ่อนปุ่มอย่างเดียวกันคนยิง API ตรงไม่ได้)\ns.mkCanRun = () => s.rows.some((r) => s.canManage(r));\n\n// เรียก API แล้วเก็บผลไว้ในโซน — ผล process อยู่ที่ res.data (reply.data อีกชั้น)\n//\n// 🔴 ใช้ globalUserState ไม่ใช่ getFormRef().userState\n//    globalUserState = userState ตัวเดียวกัน แต่ SdFormRender provide ไว้ให้ inject ตั้งแต่ created\n//    (SdFormRender.vue:300) ส่วน getFormRef() ต้องรอ form register ตัวเอง ซึ่งใน App UI มี wrapper\n//    คั่นหลายชั้น (SdAppViewer → SdCrudForm → async SdFormRender) เลยได้ null (เกิดจริง 2026-07-31)\ns.load = () => {\n  if (s.loading) return;\n  const api = field.globalUserState || (field.getFormRef() && field.getFormRef().userState);\n  if (!api || !api.runProcess) { s.errMsg = 'Cannot reach the API from this screen'; return; }\n  s.loading = true;\n  s.errMsg = null;\n  api.runProcess(\n    '6a6c1f0f265885c2377cc124',\n    {\n      api_version: 1,\n      q: s.fQ || '',\n      location: s.fLoc || '',\n      status: s.fStatus.length ? s.fStatus : '',   // ไม่เลือกสถานะไหนเลย = เอาหมด\n      limit: s.pageSize,\n      skip: (s.page - 1) * s.pageSize,\n    },\n    (res) => {\n      s.loading = false;\n      const r = (res && res.data) || {};\n      if (!r.ok) { s.errMsg = r.message || 'Unable to load stock status'; return; }\n      s.rows = r.rows || [];\n      s.summary = r.summary || { critical: 0, low: 0, ok: 0, over: 0 };\n      s.total = Number(r.total) || 0;\n      s.asOf = r.as_of || null;\n      if (!s.fLoc) {\n        s.rows.forEach((x) => { if (x.location && s.locList.indexOf(x.location) < 0) s.locList.push(x.location); });\n        s.locList.sort();\n      }\n    },\n    (err) => {\n      s.loading = false;\n      s.errMsg = (err && err.message) ? err.message : 'Unable to load stock status';\n    },\n  );\n};\n\n// เปลี่ยนเงื่อนไขต้องกลับหน้า 1 เสมอ — ไม่งั้นค้างอยู่หน้า 5 ของผลที่มีแค่ 2 หน้า = จอว่างทั้งที่มีข้อมูล\ns.reload = () => { s.page = 1; s.load(); };\ns.goPage = (p) => { s.page = p; s.load(); };\ns.pageCount = () => Math.max(1, Math.ceil((s.total || 0) / s.pageSize));\ns.rangeText = () => {\n  if (!s.total) return '0';\n  const from = (s.page - 1) * s.pageSize + 1;\n  return from + '–' + Math.min(s.total, from + s.rows.length - 1) + ' / ' + s.total;\n};\n\n// 🔴 ห้ามใช้ v-model กับค่าใน vueState — scope proxy ของ SDCustomContent มีแต่ trap get/has\n//    (ไม่มี set) → การเขียนกลับหลุดไปลง target เปล่า แล้ว template พังเป็น error box ทั้ง widget\n//    ต้อง :model-value + @change/@input เรียก setter ที่ normalize ค่าเอง\ns.setLoc = (v) => { s.fLoc = v || ''; s.reload(); };\ns.setQ = (v) => { s.fQ = v == null ? '' : String(v); };\n\n// กด chip สรุป = เปิด/ปิดสถานะนั้น (เลือกได้หลายอัน) — ตัวเลขบน chip มาจาก summary\n// ซึ่งนับทุกแถวที่มี par level เสมอ ไม่ลดตามการกรอง จึงใช้เป็นภาพรวมได้ตลอด\ns.toggleStatus = (st) => {\n  const i = s.fStatus.indexOf(st);\n  if (i >= 0) s.fStatus.splice(i, 1); else s.fStatus.push(st);\n  s.reload();\n};\ns.isOn = (st) => s.fStatus.indexOf(st) >= 0;\n\n// วันที่แบบไทย พ.ศ. — 'YYYY-MM-DD HH:mm:ss' (ค.ศ. จาก server) → 'DD/MM/BBBB HH:mm น.'\ns.thDate = (v) => {\n  if (!v) return '';\n  const p = String(v).split(' ');\n  const d = (p[0] || '').split('-');\n  if (d.length !== 3) return String(v);\n  const time = (p[1] || '').slice(0, 5);\n  return d[2] + '/' + d[1] + '/' + (Number(d[0]) + 543) + (time ? ' ' + time + ' น.' : '');\n};\n\n// ── กางดู lot ของแถว ────────────────────────────────────────────────────────\n// เก็บผลไว้ใน cache ต่อคีย์ 'ITEM@LOC' — กางซ้ำแถวเดิมไม่ต้องยิง API ใหม่\ns.openKey = '';\ns.lotCache = {};\ns.lotLoading = '';\ns.lotErr = '';\n\ns.rowKey = (r) => r.item_code + '@' + r.location;\n\ns.toggleLot = (r) => {\n  const k = s.rowKey(r);\n  if (s.openKey === k) { s.openKey = ''; return; }   // กดซ้ำ = พับเก็บ\n  s.openKey = k;\n  s.tab = 'lots';   // เปิดแถวใหม่เริ่มที่ lot เสมอ ไม่ค้างแท็บของแถวก่อนหน้า\n  s.lotErr = '';\n  if (s.lotCache[k]) return;\n\n  const api = field.globalUserState || (field.getFormRef() && field.getFormRef().userState);\n  if (!api || !api.runProcess) { s.lotErr = 'Cannot reach the API from this screen'; return; }\n  if (!'6a6c2e07265885c2377cc128' || '6a6c2e07265885c2377cc128'.indexOf('__REPLACE') === 0) {\n    s.lotErr = 'Lot API is not linked yet'; return;\n  }\n\n  s.lotLoading = k;\n  api.runProcess(\n    '6a6c2e07265885c2377cc128',\n    { api_version: 1, item: r.item_code,