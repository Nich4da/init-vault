    "cssCode": ".ss-wrap{font-size:13px}\n.ss-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}\n/* el-button ที่อยู่ติดกันมี margin-left ของตัวเองอีก 12px ซ้อนกับ gap ของแถบ → ห่างผิดจังหวะ */\n.ss-bar .el-button+.el-button{margin-left:0}\n.ss-q{width:260px}\n.ss-loc{width:180px}\n.ss-time{color:var(--el-text-color-secondary);font-size:12px;margin-left:auto}\n.ss-sum{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}\n.ss-chip{display:flex;align-items:baseline;gap:6px;padding:6px 12px;border-radius:6px;cursor:pointer;\n border:1px solid var(--el-border-color-light);background:var(--el-fill-color-light);\n transition:border-color .15s,background-color .15s;user-select:none}\n.ss-chip:hover{border-color:var(--el-border-color-darker)}\n.ss-chip b{font-size:18px;line-height:1}\n.ss-chip span{color:var(--el-text-color-secondary);font-size:12px}\n.ss-chip.ss-c-danger b{color:var(--el-color-danger)}\n.ss-chip.ss-c-warning b{color:var(--el-color-warning)}\n.ss-chip.ss-c-info b{color:var(--el-color-info)}\n.ss-chip.ss-c-success b{color:var(--el-color-success)}\n/* chip ที่กำลังกรองอยู่ — ขอบสีตามหมวด + พื้นอ่อน ให้เห็นว่าตารางกำลังโชว์อะไร */\n.ss-chip.ss-on{background:var(--el-fill-color)}\n.ss-c-danger.ss-on{border-color:var(--el-color-danger)}\n.ss-c-warning.ss-on{border-color:var(--el-color-warning)}\n.ss-c-info.ss-on{border-color:var(--el-color-info)}\n.ss-c-success.ss-on{border-color:var(--el-color-success)}\n.ss-alert{margin-bottom:10px}\n.ss-head,.ss-row{display:grid;grid-template-columns:minmax(160px,2.2fr) minmax(110px,1.2fr) 80px 90px 110px minmax(120px,1.4fr) 90px;\n gap:10px;align-items:center;padding:8px 10px}\n.ss-head{font-size:12px;font-weight:600;color:var(--el-text-color-secondary);\n border-bottom:1px solid var(--el-border-color);text-transform:uppercase;letter-spacing:.03em}\n.ss-row{border-bottom:1px solid var(--el-border-color-lighter);cursor:pointer}\n.ss-row:hover{background:var(--el-fill-color-light)}\n.ss-row.ss-