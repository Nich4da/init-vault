  "constraints": [
    "Do not use requested_at as received_at.",
    "Do not invent reference ranges, result units, prices, critical thresholds, tube colors, turnaround times, or LIS API details.",
    "Use runtime user context for audit actors; do not hard-code a user name.",
    "All production workflow writes must be implemented server-side with authorization and an audit trail."
  ]
