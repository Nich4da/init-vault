          "fields": [
            {
              "name": "List View",
              "component": "list-ui",
              "category": "display_ui",
              "icon": "list-ui",
              "fieldType": "None",
              "fieldLength": null,
              "children": false,
              "enable": true,
              "formItemFlag": false,
              "options": {
                "name": "lab_result_items_list",
                "columnSpan": 24,
                "hidden": false,
                "formId": "6a7aa641935ed08882467374",
                "parentId": "",
                "params": null,
                "titleEnable": true,
                "titleName": "รายการผลตรวจ",
                "iconName": "addon-flask",
                "initData": null,
                "subformWidth": 960,
                "where": "order_status_id = '__NO_CONTEXT__' AND xrstatx NOT IN(0,3)",
                "orderBy": [
                  {
                    "column": "result_sequence",
                    "sort": "ASC"
                  },
                  {
                    "column": "test_code",
                    "sort": "ASC"
                  }
                ],
                "searchField": [
                  "test_code",
                  "obs_code",
                  "test_name",
                  "result_value"
                ],
                "limitRow": 100,
                "actionEnable": true,
                "addBtnEnable": false,
                "delBtnEnable": false,
                "viewBtnEnable": false,
                "reloadBtnEnable": true,
                "updateBtnEnable": false,
                "height": "600px",
                "providerType": "FORM",
                "allowDeleteFunc": "",
                "buttonsRow": [
                  {
                    "prefixIcon": "el-view",
                    "label": "ดู / ลงผล",
                    "type": "primary",
                    "suffixIcon": "",
                    "color": "",
                    "disabled": false,
                    "plain": true,
                    "circle": false,
                    "round": true,
                    "loading": false,
                    "confirm": false,
                    "confirmTitle": "",
                    "badge": 0,
                    "badgeMax": 99,
                    "tag": "button",
                    "href": "",
                    "blank": false,
                    "onClick": "const host=this.getFormRef&&this.getFormRef();\nconst raw=dataRow&&(dataRow._id||dataRow.dataid||dataRow.id);\nconst id=typeof raw==='object'?String(raw.$oid||raw.value||raw._id||''):String(raw||'');\nif(!host||typeof host.openForm!=='function'||!/^[a-f0-9]{24}$/i.test(id)){this.notify('ไม่พบ Result Item ID ที่ถูกต้อง','warning',3000);return;}\nconst source=String((dataRow&&dataRow.result_source)||'').toLowerCase();\nconst readonly=source!==''&&source!=='manual';\nconst listField=this;\nhost.openForm('6a7aa641935ed08882467374',id,null,{}, {\n  readonly:readonly,\n  popupType:'dialog',\n  backdrop:false,\n  afterSaveCallback:()=>{\n    if(typeof host.subFormClose==='function')host.subFormClose();\n    const editor=listField.getFieldEditor&&listField.getFieldEditor();\n    if(editor&&typeof editor.handleRefresh==='function')editor.handleRefresh();\n  }\n});"
                  }
                ],
                "reportList": null,
                "defaultFilterParent": false,
                "parentPath": "_id",
                "showWhenParent": false,
                "enableWs": true,
                "listType": "listview",
                "iconWigth": 48,
                "iconField": null,
                "titleContent": "",
                "titleField": null,
                "detailContent": "<div class=\"lab-result-row\"><div class=\"lab-result-test\"><b>{{testName}}</b><small>{{testCode}}</small></div><div class=\"lab-result-value\"><label>ผลตรวจ</label><strong>{{resultValue}}</strong></div><div class=\"lab-result-unit\"><label>หน่วย</label><span>{{unitLabel}}</span></div><div class=\"lab-result-reference\"><label>ค่าปกติ</label><span>{{referenceLabel}}</span></div><div class=\"lab-result-critical {{criticalClass}}\"><label>ค่าวิกฤติ</label><b>{{criticalLabel}}</b></div><div class=\"lab-result-comment\"><label>หมายเหตุ</label><span>{{commentLabel}}</span></div></div>",
                "statusContent": "",
                "statusField": null,
                "colorField": null,
                "groupField": null,
                "disableNoMore": false,
                "scrollDistance": 1,
                "listColumn": 1,
                "detailMaxRow": 10,
                "totalEnable": true,
                "noMoreLabel": "หมดรายการ",
                "searchPlaceholder": "ค้นหารายการตรวจ รหัสผล หรือค่าผล",
                "clickEvent": null,
                "customValue": [
                  {
                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "testName",
                    "expressions": "String(row.test_name||row.obs_name||row.test_code||row.obs_code||'-')"
                  },
                  {
                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "testCode",
                    "expressions": "String(row.obs_code||row.test_code||'-')"
                  },
                  {
                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "resultValue",
                    "expressions": "(row.result_value!==undefined&&row.result_value!==null&&String(row.result_value)!=='')?String(row.result_value):'รอผล'"
                  },
                  {
                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "unitLabel",
                    "expressions": "String(row.unit_symbol_snapshot||row.unit_symbol||row.unit||row.units||'-')"
                  },
                  {
                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "referenceLabel",
                    "expressions": "String(row.reference_range_snapshot||row.reference_range||row.ref_range||'-')"
                  },
                  {
                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "criticalLabel",
                    "expressions": "(row.is_critical===true||String(row.is_critical).toLowerCase()==='true')?'CRITICAL':'ปกติ'"
                  },
                  {
                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "criticalClass",
                    "expressions": "(row.is_critical===true||String(row.is_critical).toLowerCase()==='true')?'is-critical':'is-normal'"
                  },
                  {
                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "commentLabel",
                    "expressions": "String(row.critical_comment||row.result_comment||'')"
                  }
                ],
                "customClass": "lab-result-items-list",
                "onCreated": "",
                "onMounted": "",
                "onUnmount": "",
                "onInsertBefore": "",
                "onUpdateBefore": "",
                "onViewBefore": "",
                "onBeforeSave": "",
                "onAfterDelete": "",
                "onselect": "",
                "onunselect": "",
                "label": "รายการผลตรวจ",
                "wsRefresh": true
              },
              "id": "list-ui95108"
            }
          ]
        }
