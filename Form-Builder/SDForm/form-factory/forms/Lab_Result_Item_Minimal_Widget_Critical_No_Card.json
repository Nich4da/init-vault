        "onChange": "const field = this.refField('result_status');\nif (field) {\n  const current = this.getValue();\n  const hasResult = current !== null && current !== undefined && String(current).trim() !== '';\n  field.setValue(hasResult ? 'final' : 'pending');\n}",
