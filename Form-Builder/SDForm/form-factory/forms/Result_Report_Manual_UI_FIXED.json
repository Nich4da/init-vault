  "formConfig": {
    "modelName": "formData",
    "refName": "sdForm",
    "rulesName": "rules",
    "labelWidth": 120,
    "labelPosition": "top",
    "size": "",
    "labelAlign": "label-right-align",
    "cssCode": ".lab-result-items-list{margin-top:12px}.lab-result-row{display:grid;grid-template-columns:minmax(220px,1.6fr) minmax(180px,1.2fr) minmax(90px,.6fr) minmax(170px,1fr) minmax(105px,.65fr);gap:12px;align-items:start;width:100%;padding:6px 0}.lab-result-row label{display:block;color:#909399;font-size:12px;margin-bottom:4px}.lab-result-test b,.lab-result-value strong{display:block;color:#303133}.lab-result-test small{display:block;color:#909399;margin-top:4px}.lab-result-value strong,.lab-result-reference span,.lab-result-comment span{white-space:pre-wrap;overflow-wrap:anywhere}.lab-result-critical{padding:6px 8px;border-radius:6px;text-align:center}.lab-result-critical.is-critical{color:#c45656;background:#fef0f0}.lab-result-critical.is-normal{color:#529b2e;background:#f0f9eb}.lab-result-comment{grid-column:1/-1}.lab-result-attachments{margin-top:8px}@media(max-width:900px){.lab-result-row{grid-template-columns:1fr 1fr}.lab-result-comment{grid-column:1/-1}}",
    "customClass": [],
    "functions": "",
    "layoutType": "PC",
    "jsonVersion": 3,
    "onFormCreated": "",
    "onFormMounted": "const ctx=(typeof formParams!=='undefined'&&formParams)||(this&&this.formParams)||{};\nconst raw=ctx.order_status_id||ctx.status_record_id||ctx.source_order_id||'';\nconst statusId=typeof raw==='object'?String(raw.$oid||raw.value||raw._id||''):String(raw||'');\nif(!/^[a-f0-9]{24}$/i.test(statusId))return;\nconst form=this;\nsetTimeout(()=>{\n  const list=form&&form.getFieldRef&&form.getFieldRef('lab_result_items_list');\n  if(!list)return;\n  const where=\"order_status_id = '\"+statusId+\"' AND xrstatx NOT IN(0,3)\";\n  if(typeof list.setFieldOption==='function')list.setFieldOption('where',where);\n  const editor=list.getFieldEditor&&list.getFieldEditor();\n  if(!editor)return;\n  editor.dpFormData=editor.dpFormData||{};\n  editor.dpFormData.options=editor.dpFormData.options||{};\n  editor.defaultWhere=where;\n  editor.dpFormData.options.where=where;\n  if(typeof editor.handleRefresh==='function')editor.handleRefresh();\n},80);",
    "onParentChange": "",
    "onFormDataChange": "",
    "onFormUnmounted": ""
  }
}
