    "onFormDataChange": "if (['overall_status','stage'].includes(fieldName)) return;\nconst valueNow = this.getFieldValue('result_value');\nconst statusNow = this.getFieldValue('result_status');\nconst hasValue = valueNow !== null && valueNow !== undefined && String(valueNow).trim() !== '';\nconst isFinal = hasValue && ['final','corrected'].includes(statusNow);\nconst isResulted = hasValue && ['entered','final','corrected'].includes(statusNow);\nthis.setFieldValue('resulted_count', isResulted ? 1 : 0);\nthis.setFieldValue('final_count', isFinal ? 1 : 0);\nthis.setFieldValue('overall_status', isFinal ? 'completed' : (isResulted ? 'resulted' : 'processing'));\nthis.setFieldValue('stage', isFinal ? 'final' : 'preliminary');",
