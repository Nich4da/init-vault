                    "labelWidth": 150,
                    "align": "left",
                    "fieldName": "statusClass",
                    "expressions": "(function(){var s=String(row.overall_status||'').toLowerCase();return ['resulted','completed'].includes(s)?'is-complete':s==='corrected'?'is-corrected':['processing','in_progress','partial'].includes(s)?'is-partial':'is-default'})()"
                  },
