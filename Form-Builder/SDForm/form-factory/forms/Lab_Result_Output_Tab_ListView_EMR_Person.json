                    "expressions": "(function(){var s=String(row.overall_status||'').toLowerCase(),m={processing:'กำลังตรวจ',in_progress:'ออกผลบางส่วน',partial:'ออกผลบางส่วน',resulted:'ออกผลแล้ว',completed:'ออกผลครบ',corrected:'แก้ไขผล',cancelled:'ยกเลิกผล'};return m[s]||s||'-'})()"
                  },
