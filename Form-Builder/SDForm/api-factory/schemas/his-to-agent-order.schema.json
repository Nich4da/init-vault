{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsnich.example/schemas/his-to-agent-order.schema.json",
  "title": "HIS to Agent Lab Order",
  "description": "Canonical HIS payload sent to POST {AGENT_URL}/api/orders after the Lab user receives the specimen. Scope ends at the Agent boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "order_no",
    "labno",
    "hn",
    "ordered_at",
    "priority",
    "sex",
    "items"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "const": "lab.order.submit",
      "description": "Event discriminator for a normal LAB order submitted from HIS to Agent. Blood Bank uses a separate contract."
    },
    "order_no": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "HIS order identifier and outbound idempotency key."
    },
    "labno": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "LAB NO. available before transmission; issued by CPOE for source-managed rooms and by LAB/HIS for other rooms."
    },
    "hn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "visit_id": {
      "type": "string",
      "maxLength": 100
    },
    "ordered_at": {
      "$ref": "#/$defs/thailandDateTime"
    },
    "requested_at": {
      "$ref": "#/$defs/thailandDateTime"
    },
    "priority": {
      "type": "string",
      "enum": ["S", "A", "R"]
    },
    "note": {
      "type": ["string", "null"]
    },
    "patient_prefix": {
      "type": "string",
      "maxLength": 100
    },
    "patient_first_name": {
      "type": "string",
      "maxLength": 200
    },
    "patient_last_name": {
      "type": "string",
      "maxLength": 200
    },
    "mother_name": {
      "type": "string",
      "description": "Mother name supplied by HIS for Agent/LAB use. Optional until the authoritative HIS source mapping is confirmed."
    },
    "is_maternal_blood": {
      "type": "boolean",
      "description": "Whether the submitted specimen is maternal blood. Optional and must not be inferred when the HIS source does not provide an explicit boolean."
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{8}([0-9]{6})?$",
      "description": "YYYYMMDD or YYYYMMDDHHmmss."
    },
    "sex": {
      "type": "string",
      "enum": ["M", "F"]
    },
    "visit_type": {
      "type": "string",
      "enum": ["OPD", "IPD"],
      "description": "Patient encounter type derived from admission context; a non-empty AN is IPD, otherwise OPD."
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["OPD", "IPD"],
          "description": "Patient encounter class derived from admission context; a non-empty AN is IPD, otherwise OPD."
        }
      }
    },
    "doctor_code": {
      "type": "string",
      "maxLength": 100
    },
    "doctor_title": {
      "type": "string",
      "maxLength": 100
    },
    "doctor_name": {
      "type": "string",
      "maxLength": 300
    },
    "clinic_code": {
      "type": "string",
      "maxLength": 100
    },
    "clinic_name": {
      "type": "string",
      "maxLength": 300
    },
    "station": {
      "type": "string",
      "maxLength": 200
    },
    "station_seq": {
      "type": "string",
      "maxLength": 100
    },
    "special_request": {
      "type": "string"
    },
    "diagnosis": {
      "type": "string"
    },
    "antimicrobial_used": {
      "type": "string"
    },
    "underlying_disease": {
      "type": "string"
    },
    "mongo_form_id": {
      "type": "string",
      "maxLength": 100
    },
    "mongo_data_id": {
      "type": "string",
      "maxLength": 100
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/orderItem"
      }
    }
  },
  "$defs": {
    "thailandDateTime": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^[0-9]{14}$"
        },
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+07:00$"
        }
      ],
      "description": "Thailand local time as YYYYMMDDHHmmss or ISO-8601 with +07:00."
    },
    "orderItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "test_code",
        "test_name",
        "specimen_code",
        "collected_at",
        "received_at",
        "receiver"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Outbound item sequence. The current order sample and transport specification use a number."
        },
        "test_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Confirmed contract: value is his_code_id and equals the inbound obs_code for the same ordered test."
        },
        "test_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "specimen_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "specimen_name": {
          "type": "string",
          "maxLength": 300
        },
        "collector_code": {
          "type": "string",
          "maxLength": 100
        },
        "collector_name": {
          "type": "string",
          "maxLength": 300
        },
        "lab_code": {
          "type": "string",
          "maxLength": 100
        },
        "comment": {
          "type": "string",
          "maxLength": 2000,
          "description": "Item-level comment required by CPOE Item req_commt for source-managed rooms."
        },
        "specimens": {
          "type": "array",
          "minItems": 1,
          "description": "One or more specimen rows supplied by CPOE when multi_specimen is enabled.",
          "items": {
            "$ref": "#/$defs/specimen"
          }
        },
        "collected_at": {
          "$ref": "#/$defs/thailandDateTime"
        },
        "received_at": {
          "$ref": "#/$defs/thailandDateTime"
        },
        "receiver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "HIS identity/code of the user who received the specimen."
        }
      }
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_site_code": { "type": "string", "maxLength": 100 },
        "spec_site_name": { "type": "string", "maxLength": 300 },
        "spec_source_code": { "type": "string", "maxLength": 100 },
        "spec_source": { "type": "string", "maxLength": 300 },
        "specimen_at": {
          "anyOf": [
            { "$ref": "#/$defs/thailandDateTime" },
            { "type": "string", "maxLength": 0 }
          ]
        },
        "ship_storage": { "type": "string", "maxLength": 100 },
        "ship_temp": { "type": ["number", "null"] },
        "spec_note": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
