[
  {
    "$match": {
      "xrstatx": { "$nin": [0, 3] },
      "$or": [
        { "service_type.value": "xray" },
        { "service_type": "xray" }
      ]
    }
  },
  {
    "$addFields": {
      "_order_key": { "$toString": { "$ifNull": ["$order_id.value", "$xparentx"] } }
    }
  },
  {
    "$lookup": {
      "from": "zdata_cpoe_order",
      "localField": "order_id.value",
      "foreignField": "_id",
      "as": "_order_rows"
    }
  },
  {
    "$addFields": {
      "_order": { "$arrayElemAt": ["$_order_rows", 0] }
    }
  },
  {
    "$match": {
      "_order.xrstatx": { "$nin": [0, 3] }
    }
  },
  {
    "$addFields": {
      "_visit_key": { "$toString": { "$ifNull": ["$_order.xparentx", "$_order.vid.value"] } }
    }
  },
  {
    "$group": {
      "_id": "$_order_key",
      "visit_id": { "$first": "$_visit_key" },
      "order_number": { "$first": { "$ifNull": ["$_order.order_number", ""] } },
      "order_created_at": { "$first": { "$ifNull": ["$_order.created_at", ""] } },
      "hn": { "$first": { "$ifNull": ["$_order.vid.pid.hn", ""] } },
      "patient_name": {
        "$first": {
          "$trim": {
            "input": {
              "$concat": [
                { "$ifNull": ["$_order.vid.pid.prename.label", ""] },
                " ",
                { "$ifNull": ["$_order.vid.pid.p_fname", ""] },
                " ",
                { "$ifNull": ["$_order.vid.pid.p_lname", ""] }
              ]
            }
          }
        }
      },
      "item_count": { "$sum": 1 },
      "_accessions": { "$push": { "$ifNull": ["$accession_no", ""] } },
      "_item_codes": { "$push": { "$ifNull": ["$item_code", ""] } }
    }
  },
  {
    "$addFields": {
      "order_id": "$_id",
      "accession_count": {
        "$size": {
          "$filter": {
            "input": "$_accessions",
            "as": "value",
            "cond": { "$ne": ["$$value", ""] }
          }
        }
      },
      "item_codes": {
        "$reduce": {
          "input": "$_item_codes",
          "initialValue": "",
          "in": {
            "$cond": [
              { "$eq": ["$$value", ""] },
              "$$this",
              { "$concat": ["$$value", ", ", "$$this"] }
            ]
          }
        }
      }
    }
  },
  { "$sort": { "order_created_at": -1 } },
  { "$limit": 20 },
  {
    "$project": {
      "_id": 0,
      "order_id": 1,
      "visit_id": 1,
      "order_number": 1,
      "order_created_at": 1,
      "hn": 1,
      "patient_name": 1,
      "item_count": 1,
      "accession_count": 1,
      "item_codes": 1
    }
  }
]
