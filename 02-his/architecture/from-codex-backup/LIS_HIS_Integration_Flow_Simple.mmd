flowchart LR
    subgraph outbound ["HIS ส่งคำสั่งตรวจไป LIS"]
        direction TB
        createOrder["สร้างใบสั่งตรวจ"]
        createKeys["HIS สร้าง order_no และ labno"]
        sendOrder["ส่ง JSON Order และ Items"]
        validateOrder{"ข้อมูลถูกต้องหรือไม่"}
        fixOrder["แจ้งเหตุผลให้แก้ข้อมูล"]
        queueOrder["LISconnect เข้าคิวและสร้างไฟล์ .req"]
        lisWork["LIS รับรายการและตรวจตัวอย่าง"]

        createOrder --> createKeys --> sendOrder --> validateOrder
        validateOrder -->|"ไม่ถูกต้อง"| fixOrder
        validateOrder -->|"ถูกต้อง"| queueOrder --> lisWork
    end

