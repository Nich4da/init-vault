        saveResult["บันทึกผลโดยไม่ทับประวัติเดิม"]
        resultComplete{"ผลครบหรือยัง"}
        partialResult["ออกผลบางส่วน"]
        finalResult["ออกผลครบ"]
        showResult["แสดงผลในหน้าห้อง Lab และ HIS"]

        lisResult --> convertResult --> sendResult --> matchResult --> saveResult --> resultComplete
        resultComplete -->|"ยังไม่ครบ"| partialResult --> showResult
        resultComplete -->|"ครบ"| finalResult --> showResult
    end

    lisWork -.->|"เมื่อมีผล"| lisResult
