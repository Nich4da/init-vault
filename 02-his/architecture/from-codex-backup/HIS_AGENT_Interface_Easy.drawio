        <mxCell id="fm-idem-order" value="&lt;b&gt;Order idempotency&lt;/b&gt;&lt;br&gt;&lt;br&gt;ส่ง order_no เดิมซ้ำได้&lt;br&gt;200 duplicate = สำเร็จ&lt;br&gt;ห้ามสร้าง outbound order ใหม่" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;dashed=1;spacingLeft=10;spacingTop=8;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#6c8ebf,#6c8ebf);" vertex="1" parent="fm-1">
          <mxGeometry x="40" y="630" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fm-idem-result" value="&lt;b&gt;Result idempotency&lt;/b&gt;&lt;br&gt;&lt;br&gt;result_uid เป็น unique message key&lt;br&gt;receipt_seq และ result_version เป็น string&lt;br&gt;ส่งซ้ำต้องไม่สร้าง Result ซ้ำ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;dashed=1;spacingLeft=10;spacingTop=8;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#9673a6,#9673a6);" vertex="1" parent="fm-1">
          <mxGeometry x="650" y="630" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fm-status" value="&lt;b&gt;Result status mapping&lt;/b&gt;&lt;br&gt;&lt;br&gt;in_progress + มีผล → ออกผลบางส่วน&lt;br&gt;resulted → ออกผลครบ&lt;br&gt;corrected / cancelled เตรียมรองรับอนาคต" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;dashed=1;spacingLeft=10;spacingTop=8;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#82b366,#82b366);" vertex="1" parent="fm-1">
          <mxGeometry x="1240" y="630" width="500" height="170" as="geometry" />
        </mxCell>

        <mxCell id="fm-critical" value="&lt;b&gt;Critical&lt;/b&gt;&lt;br&gt;&lt;br&gt;มี critical_low_rule หรือ critical_high_rule → HIS แสดง Critical&lt;br&gt;HIS เก็บค่าที่ได้รับและไม่คำนวณ threshold ซ้ำ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;dashed=1;spacingLeft=10;spacingTop=8;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="fm-1">
          <mxGeometry x="40" y="840" width="820" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fm-match-rule" value="&lt;b&gt;Matching rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;ใช้ order_no + filler_order_no + visit_id เป็น cross-check&lt;br&gt;แล้วจับ Result Item ด้วย obs_code = his_code_id&lt;br&gt;ห้าม match ด้วย HN หรือ LAB NO. เพียงค่าเดียว" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;dashed=1;spacingLeft=10;spacingTop=8;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#999999,#777777);" vertex="1" parent="fm-1">
          <mxGeometry x="900" y="840" width="840" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
