        <mxCell id="lisflow-overview-c18" value="&lt;b&gt;ประกอบไฟล์ .req (rax-file)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HL7 v2.03 ORM^O01 · เข้ารหัส TIS-620 ไม่ใช่ UTF-8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
