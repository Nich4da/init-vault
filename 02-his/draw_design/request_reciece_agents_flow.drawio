        <mxCell id="lisflow-overview-c17" value="&lt;b&gt;routing ตาม items[].test_code&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LISconnect เลือกแล็บเอง — HIS ยิงเส้นเดียวทุกแล็บ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
