  <diagram id="lisflow-submit" name="Order Submit Flow">
    <mxGraphModel dx="1030" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2000" pageHeight="1298" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lisflow-submit-c1" value="Order Submit Flow — HIS → LISconnect → ห้องแล็บ" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=light-dark(#1a1a1a,#f0f0f0);" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1880" height="30" as="geometry" />
