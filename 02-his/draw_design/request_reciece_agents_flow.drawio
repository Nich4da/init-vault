        <mxCell id="lisflow-receive-e29" value="callback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lisflow-receive-c16" target="lisflow-receive-c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c30" value="ทางที่ไม่ใช่ทางหลัก — ต้องออกแบบจอรองรับ ไม่ใช่ปล่อยให้เงียบ" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c31" value="&lt;b&gt;กด &quot;ไม่รับ Specimen&quot;&lt;/b&gt;&lt;br&gt;&lt;br&gt;หลอดผิด · ปริมาณไม่พอ · ไม่มีป้าย&lt;br&gt;ใบยังไม่เคยออกจาก HIS → &lt;b&gt;ยกเลิกในระบบ ไม่ต้องรบกวนแล็บ&lt;/b&gt;&lt;br&gt;ต้องบันทึกเหตุผลไว้ให้คนสั่งเห็นในแท็บ &quot;ยกเลิกรายการ&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;dashed=1;spacingLeft=8;spacingTop=6;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c32" value="&lt;b&gt;ยกเลิกหลังใบออกไปแล้ว&lt;/b&gt;&lt;br&gt;&lt;br&gt;ส่งแล้วยังไม่มีผล → ใบยกเลิก ORC-1 = CA → cancel_requested → cancelled&lt;br&gt;&lt;b&gt;มีผลกลับมาแล้ว → 409 cancel_rejected&lt;/b&gt; ยกเลิกย้อนหลังไม่ได้&lt;br&gt;🔴 ห้าม retry เงียบ ต้องขึ้นให้ผู้สั่งเห็น" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;dashed=1;spacingLeft=8;spacingTop=6;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="1">
          <mxGeometry x="520" y="850" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c33" value="&lt;b&gt;Agent ล่ม / ยังไม่ได้ตั้ง mapping&lt;/b&gt;&lt;br&gt;&lt;br&gt;503 not_configured · 503 draining · 500 internal&lt;br&gt;คง &lt;b&gt;hl7_status = new&lt;/b&gt; ไว้ แล้วให้ reconcile cron เก็บทีหลัง&lt;br&gt;🔴 receive stamp ที่บันทึกไว้แล้วห้ามลบทิ้ง" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;dashed=1;spacingLeft=8;spacingTop=6;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="1">
          <mxGeometry x="1000" y="850" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c34" value="&lt;b&gt;ปุ่ม &quot;แก้ไขเลขใหม่&quot; บนคิว&lt;/b&gt;&lt;br&gt;&lt;br&gt;ออก labno ใหม่ให้ใบเดิม&lt;br&gt;ถ้าใบเดิมส่งออกไปแล้ว = ผลที่กลับมาจะจับคู่ไม่เจอ&lt;br&gt;⏳ ต้องเคาะว่าอนุญาตแก้ได้ถึงสถานะไหน (ดูหน้า Open Questions)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;dashed=1;spacingLeft=8;spacingTop=6;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#999999,#777777);" vertex="1" parent="1">
          <mxGeometry x="1480" y="850" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c35" value="LEGEND" style="rounded=0;html=1;fillColor=light-dark(#fafafa,#1c1c1c);strokeColor=light-dark(#8a8a8a,#9aa3ad);verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="1004.0" width="1600" height="116" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c36" value="" style="rounded=0;html=1;fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);" vertex="1" parent="lisflow-receive-c35">
          <mxGeometry x="10" y="30" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c37" value="ของเดิม — ไม่ต้องแก้" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="lisflow-receive-c35">
          <mxGeometry x="30" y="30" width="760" height="16" as="geometry" />
