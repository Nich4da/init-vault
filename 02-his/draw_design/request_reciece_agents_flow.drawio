        <mxCell id="lisflow-submit-c2" value="เส้นทางที่สัญญาล็อกไว้แล้วและฝั่ง LISconnect เปิดรออยู่ · ตอบทันทีที่ commit เข้าคิว ไม่รอให้ไฟล์ถึงแล็บ · ขั้นสีม่วง = ทีม HIS ต้องเขียน" style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=light-dark(#777777,#999999);" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1920" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c3" value="จอ HIS ห้องแล็บ" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1900" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c4" value="HIS — ขาส่งใบสั่ง (ต้องเขียน)" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1900" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c5" value="LISconnect · POST /api/orders" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1900" height="170" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c6" value="ห้องแล็บ (rax-file)" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1900" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c7" value="&lt;b&gt;1 · กด &quot;รับ Specimen&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;บนแท็บ &quot;รอรับเข้า&quot; หลังยืนยันตัวผู้ป่วย&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-submit-c3">
          <mxGeometry x="60" y="30" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c8" value="&lt;b&gt;9 · คิวขึ้นสถานะให้คนสั่งเห็น&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;queued → sent → in_progress → resulted · failed/stalled ต้องเห็นด้วย&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-submit-c3">
          <mxGeometry x="1560" y="30" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c9" value="&lt;b&gt;2 · บันทึกการรับ + ออก labno&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;collected_at · received_at · receiver&lt;br&gt;labno = {ปี พ.ศ. 2}{MM}{DD}{ลำดับ 4}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-submit-c4">
          <mxGeometry x="360" y="30" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c10" value="&lt;b&gt;3 · ประกอบ Order JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;order_no · labno · hn · visit_id · ordered_at · requested_at · priority&lt;br&gt;+ ผู้ป่วย/แพทย์/คลินิก + items[]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-submit-c4">
          <mxGeometry x="660" y="30" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c11" value="&lt;b&gt;4 · POST /api/orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;header X-Agent-Key&lt;br&gt;Content-Type: application/json (ไม่ใช่ = 415 ทันที ไม่อ่าน body)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-submit-c4">
          <mxGeometry x="960" y="30" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c12" value="&lt;b&gt;8 · เก็บผลตอบรับลง HIS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hl7_status = queued · order_ref · dispatch_id · routed_to[]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-submit-c4">
          <mxGeometry x="1560" y="30" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c13" value="&lt;b&gt;5 · ตรวจ + commit เข้าคิว&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ตรวจ labno / รายการตรวจ / seq ซ้ำ · unique บน order_no&lt;br&gt;202 queued · 200 duplicate:true&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-submit-c5">
          <mxGeometry x="960" y="30" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-submit-c14" value="&lt;b&gt;6 · routing + ประกอบไฟล์&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;เลือกแล็บจาก items[].test_code เอง — HIS ไม่ต้องเลือกเส้น&lt;br&gt;rax-file: HL7 v2.03 ORM^O01 · TIS-620&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-submit-c5">
          <mxGeometry x="1260" y="30" width="250" height="120" as="geometry" />
