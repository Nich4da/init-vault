  <diagram id="lisflow-payload" name="Order Payload">
    <mxGraphModel dx="1030" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2200" pageHeight="1380" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lisflow-payload-c1" value="Order Payload — ช่องไหนมีแล้ว ช่องไหนต้องเติม" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=light-dark(#1a1a1a,#f0f0f0);" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-payload-c2" value="ฝั่ง LISconnect ต่อรอไว้ครบทั้ง 25 ตัวแล้ว (17 ตัวของ rax-file ตั้งแต่ 2026-08-06 + 8 ตัวของ mLab ตั้งแต่ 2026-08-23) — ส่งชื่อ field ตามนี้มาเมื่อไหร่ทำงานทันที · ยังไม่ส่ง = ช่องนั้นในไฟล์ว่าง ไม่ใช่ error · ชื่อ field เป็นข้อเสนอ ถ้า HIS ใช้ชื่ออื่นบอกมา แก้ที่ config ไฟล์เดียว" style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=light-dark(#777777,#999999);" vertex="1" parent="1">
