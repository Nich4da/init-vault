  <diagram id="lisflow-receive" name="Receive Flow">
    <mxGraphModel dx="1030" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2000" pageHeight="1160" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lisflow-receive-c1" value="Receive Flow — จอห้องแล็บ ตั้งแต่คิว &quot;รอรับเข้า&quot; จนใบสั่งออกจาก HIS" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=light-dark(#1a1a1a,#f0f0f0);" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1880" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c2" value="อ่านจากซ้ายไปขวา · 4 แท็บบนจอ Lab Chemistry: รอรับเข้า → รับเข้าแล้ว/รอตรวจ → ผลแลป LIS → ยกเลิกรายการ · ขั้นสีม่วง = ทีม HIS ต้องเขียนเพิ่ม · เส้นประ = callback ที่เกิดภายหลัง" style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=light-dark(#777777,#999999);" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1920" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c3" value="ผู้ใช้ห้องแล็บ · จอ Lab Chemistry" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1900" height="170" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c4" value="HIS — เหตุการณ์ในฟอร์ม" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="1900" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c5" value="LISconnect (Agent)" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1900" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c6" value="ห้องแล็บ" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1900" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c7" value="&lt;b&gt;1 · แท็บ &quot;รอรับเข้า&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ใบสั่งจาก CPOE ขึ้นคิว · เห็น Lab Number · คลินิกที่ส่ง · ผู้ส่งตรวจ · รายการตรวจ · Specimen · สถานะการชำระเงิน&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c3">
          <mxGeometry x="60" y="30" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c8" value="&lt;b&gt;2 · ยืนยันตัว แล้วกด &quot;รับ Specimen&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ตรวจ HN · ชื่อ-สกุล · AN · วันที่ขอตรวจ ก่อนกด · ปุ่ม &quot;ไม่รับ Specimen&quot; ไว้ตีกลับเมื่อหลอดผิด/ปริมาณไม่พอ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c3">
          <mxGeometry x="360" y="30" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c9" value="&lt;b&gt;9 · แท็บ &quot;รับเข้าแล้ว / รอตรวจ&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ใบที่ออกไปแล้ว รอผลกลับ · แสดง hl7_status ปัจจุบันให้คนสั่งเห็น&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c3">
          <mxGeometry x="1260" y="30" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c10" value="&lt;b&gt;11 · แท็บ &quot;ผลแลป LIS&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;แสดงทุก report_seq / stage / result_version · ผลใหม่ต่อท้าย ไม่ทับของเดิม&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c3">
          <mxGeometry x="1560" y="30" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c11" value="&lt;b&gt;3 · บันทึกการรับลง HIS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;collected_at · received_at · receiver · collector_code/name&lt;br&gt;🔴 ต้องบันทึกให้เสร็จ&lt;b&gt;ก่อน&lt;/b&gt;เรียก Agent — Agent ล่มต้องไม่ลบ receive stamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c4">
          <mxGeometry x="360" y="30" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c12" value="&lt;b&gt;4 · ออก labno + ประกอบ payload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;6908060021 = {69}{08}{06}{0021}&lt;br&gt;items[].test_code = his_code_id จาก LAB CATALOG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c4">
          <mxGeometry x="660" y="30" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c13" value="&lt;b&gt;5 · POST {AGENT_URL}/api/orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;X-Agent-Key · application/json · ≤ 1 MB · timeout ฝั่ง process 5 วินาที&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c4">
          <mxGeometry x="960" y="30" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c14" value="&lt;b&gt;8 · เก็บผลตอบรับ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hl7_status = queued · order_ref · dispatch_id · routed_to[]&lt;br&gt;200 duplicate:true ก็ถือว่าสำเร็จ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c4">
          <mxGeometry x="1260" y="30" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c15" value="&lt;b&gt;6 · ตรวจ + commit เข้าคิว + routing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;unique บน order_no → กันใบซ้ำให้เอง · ตอบทันทีที่ commit สำเร็จ ไม่รอไฟล์ถึงแล็บ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c5">
          <mxGeometry x="960" y="30" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c16" value="&lt;b&gt;10 · callback กลับ HIS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hl7_order_status_sync (สถานะ) · hl7_result_upsert (ผล) — คนละ pid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c5">
          <mxGeometry x="1560" y="30" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c17" value="&lt;b&gt;7 · ไฟล์ .req โผล่ในโฟลเดอร์แล็บ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ภายในไม่กี่วินาที · เจ้าหน้าที่ใช้ชื่อ-สกุล/เพศ/วันเกิดในใบยืนยันตัวก่อนเจาะ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c6">
          <mxGeometry x="1260" y="30" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-c18" value="&lt;b&gt;12 · แล็บออกไฟล์ .res&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;จับคู่กลับเข้าใบสั่งด้วย labno&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="lisflow-receive-c6">
          <mxGeometry x="1560" y="30" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lisflow-receive-c7" target="lisflow-receive-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-e20" value="กดรับแล้ว" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lisflow-receive-c8" target="lisflow-receive-c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-receive-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lisflow-receive-c11" target="lisflow-receive-c12">
          <mxGeometry relative="1" as="geometry" />
