        <mxCell id="lisflow-receive-c39" value="มีแล้วในระบบ / ฝั่ง LISconnect เปิดรออยู่" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="lisflow-receive-c35">
