        </mxCell>
        <mxCell id="lisflow-overview-c19" value="&lt;b&gt;mlab-file — endpoint ยังปิด&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CSV คั่น comma · รอไฟล์ตัวอย่างจริงยืนยัน charset/filename&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#fff2cc,#4a3d13);strokeColor=light-dark(#d6b656,#d6b656);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="450" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lisflow-overview-c20" value="&lt;b&gt;อ่าน .res แล้ว callback กลับ HIS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hl7_result_upsert · hl7_order_status_sync (คนละ pid)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);spacingTop=2;spacingLeft=2;spacingBottom=2;spacingRight=2;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
