        <mxCell id="lisflow-receive-c38" value="" style="rounded=0;html=1;fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);" vertex="1" parent="lisflow-receive-c35">
          <mxGeometry x="810" y="30" width="16" height="16" as="geometry" />
