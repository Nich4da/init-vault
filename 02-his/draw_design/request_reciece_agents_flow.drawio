        </mxCell>
        <mxCell id="lisflow-overview-c21" value="ปลายน้ำ — ห้องแล็บ และขารับผล" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;" vertex="1" parent="1">
