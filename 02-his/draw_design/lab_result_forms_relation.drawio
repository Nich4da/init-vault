  <diagram id="labform-role" name="2 · แต่ละฟอร์มมีไว้ทำอะไร">
    <mxGraphModel dx="1030" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2000" pageHeight="1430" math="0" shadow="0" adaptiveColors="auto">
      <root>
