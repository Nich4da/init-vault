        <mxCell id="labform-role-n3" value="&lt;b&gt;① Lab_Result_Inbound_Receive&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CRUD · zdata_lab_result_inbound&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
