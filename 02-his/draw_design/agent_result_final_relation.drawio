        <mxCell id="edgeProcessReport" value="upsert stable report" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="upsertProcess" target="report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edgeReceiptReport" value="logical message reference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#9673a6,#9673a6);labelBackgroundColor=light-dark(#ffffff,#121212);dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="receipt" target="report">
          <mxGeometry relative="1" as="geometry" />
