        <mxCell id="rulesBand" value="RELATION RULES — confirmed structure vs. implementation guardrails" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="1560" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Confirmed from this JSON snapshot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Root payload contains one report envelope and an items[] array with 2 objects. Both result_version and receipt_seq are represented as strings in this sample.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Do not merge these meanings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;result_uid = inbound-message idempotency · report_seq/stage = report snapshot progression · result_version = correction version per item · receipt_seq = message receipt count, not result version.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#fff2cc,#4a3d13);strokeColor=light-dark(#d6b656,#d6b656);align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="guardrails" value="&lt;b&gt;Clinical and integration guardrails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Match filler_order_no to LAB NO. and cross-check order_no + visit_id. Preserve source identities and prior correction history. Use explicit is_critical from the integration; do not infer criticality from range text. Do not assume obs_code equals an outbound order code or HIS master code without a confirmed contract.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#f8cecc,#4a1f1e);strokeColor=light-dark(#b85450,#b85450);align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="820" width="760" height="170" as="geometry" />
        </mxCell>
