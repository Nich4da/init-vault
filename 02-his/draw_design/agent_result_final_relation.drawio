        <mxCell id="bandPayload" value="1 · INBOUND PAYLOAD" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="360" height="32" as="geometry" />
        </mxCell>
        <mxCell id="payloadHeader" value="&lt;b&gt;Root header&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;&lt;b&gt;Order context&lt;/b&gt;&lt;br&gt;order_no&lt;br&gt;filler_order_no = LAB NO.&lt;br&gt;hn · visit_id&lt;br&gt;&lt;br&gt;&lt;b&gt;Report envelope&lt;/b&gt;&lt;br&gt;result_uid · report_seq · stage&lt;br&gt;overall_status · reported_at · verified_at&lt;br&gt;&lt;br&gt;&lt;b&gt;Source identities&lt;/b&gt;&lt;br&gt;reported_by · verified_by&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="payloadItems" value="&lt;b&gt;items[] — one payload to many components&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;panel_code · panel_name&lt;br&gt;obs_code · obs_name&lt;br&gt;value · units · ref_range&lt;br&gt;obx_status · interpretation_code&lt;br&gt;is_critical · change_kind · previous_value&lt;br&gt;result_version · receipt_seq&lt;br&gt;&lt;br&gt;&lt;b&gt;Snapshot:&lt;/b&gt; 2 item objects; values are intentionally hidden&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="360" height="245" as="geometry" />
        </mxCell>

        <mxCell id="bandProcess" value="2 · MATCH, DEDUPLICATE, NORMALIZE" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="100" width="360" height="32" as="geometry" />
        </mxCell>
        <mxCell id="upsertProcess" value="&lt;b&gt;hl7_result_upsert_api&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;1. Validate payload and items[]&lt;br&gt;2. Match filler_order_no to LAB NO.&lt;br&gt;3. Cross-check order_no and visit_id&lt;br&gt;4. Deduplicate message by result_uid&lt;br&gt;5. Preserve reported/verified identities&lt;br&gt;6. Append report_seq and stage&lt;br&gt;7. Materialize result items by component/version&lt;br&gt;8. Recalculate partial or complete status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="250" width="360" height="300" as="geometry" />
        </mxCell>

        <mxCell id="bandPersistence" value="3 · PERSISTENCE RELATION" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="receipt" value="&lt;b&gt;Technical Receipt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;&lt;b&gt;1 record = 1 inbound message&lt;/b&gt;&lt;br&gt;Idempotency: result_uid&lt;br&gt;Keeps technical receipt/audit state&lt;br&gt;Can exist even if normalization fails&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fontSize=13;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="160" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;Result Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;&lt;b&gt;1 record = one stable LAB result work&lt;/b&gt;&lt;br&gt;Match: LAB NO. + order + visit&lt;br&gt;Append: report_seq + stage&lt;br&gt;Header status and source identities&lt;br&gt;&lt;br&gt;result_uid is not the sole Report identity&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fontSize=13;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="430" width="320" height="225" as="geometry" />
        </mxCell>
        <mxCell id="resultItems" value="&lt;b&gt;Result Items&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;&lt;b&gt;1 Report : N Result Items&lt;/b&gt;&lt;br&gt;One row per reportable component/version&lt;br&gt;Key context: Report id + obs_code + version&lt;br&gt;Keeps value, units, range, status, correction&lt;br&gt;Uses explicit is_critical from integration&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fontSize=13;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="1280" y="430" width="320" height="225" as="geometry" />
        </mxCell>

        <mxCell id="edgeHeaderProcess" value="header context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="payloadHeader" target="upsertProcess">
