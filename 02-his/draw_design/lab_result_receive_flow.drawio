          <mxGeometry x="40" y="54" width="1920" height="20" as="geometry" />
        </mxCell>
        <mxCell id="labres-status-n3" value="ของที่มีแล้ว vs ของที่ยังไม่ยืนยัน end-to-end" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="labres-status-n4" value="&lt;b&gt;✅ มีแล้ว&lt;/b&gt;&lt;br&gt;• JSON technical receipt (①)&lt;br&gt;• JSON UI สำหรับ inbound user view&lt;br&gt;• Result Report และ Result Item — schema/UI รุ่นทำงาน&lt;br&gt;• Agent result JSON Schema + diagram mapping&lt;br&gt;• static tests บางส่วนสำหรับ JSON / hierarchy / mapping" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="940" height="230" as="geometry" />
        </mxCell>
        <mxCell id="labres-status-n5" value="&lt;b&gt;⏳ ยังไม่ยืนยัน end-to-end&lt;/b&gt;&lt;br&gt;• Process รับ callback จริงและสร้าง receipt&lt;br&gt;• การจับคู่ Work Item ด้วยข้อมูลจริง&lt;br&gt;• การสร้าง/ค้น Report แบบ idempotent&lt;br&gt;• การแตก items[] และ upsert Result Item&lt;br&gt;• Partial / complete status&lt;br&gt;• Correction / version history&lt;br&gt;• App runtime แสดง ListView และเปิดดูผล&lt;br&gt;• Manual submit / update / audit" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#fff2cc,#4a3d13);strokeColor=light-dark(#d6b656,#d6b656);" vertex="1" parent="1">
          <mxGeometry x="1020" y="150" width="940" height="230" as="geometry" />
        </mxCell>
        <mxCell id="labres-status-n6" value="🔴 &lt;b&gt;ระบบยังไม่ production-ready — ห้ามกล่าวว่า Agent flow หรือ Manual flow ใช้งานได้จริง จนกว่าจะผ่านการทดสอบทั้งหมด&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#f8cecc,#4a1f1e);strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="1">
          <mxGeometry x="40" y="395" width="1920" height="46" as="geometry" />
        </mxCell>
        <mxCell id="labres-status-n7" value="ข้อจำกัดของ ListView — อย่าสรุปผิดจากหน้าจอที่ไม่ใช่ของจริง" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="labres-status-n8" value="&lt;b&gt;สิ่งที่ยืนยันแล้ว&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Preview &lt;b&gt;แสดงกรอบ ListView ได้แม้มี 0 รายการ&lt;/b&gt;&lt;br&gt;• Form Manage CRUD &lt;b&gt;ไม่แสดง list-ui&lt;/b&gt; แม้ใช้ไฟล์แม่แบบเดียวกันกับที่ Preview แสดงได้" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="620" height="175" as="geometry" />
        </mxCell>
        <mxCell id="labres-status-n9" value="&lt;b&gt;สิ่งที่ต้องทำ&lt;/b&gt;&lt;br&gt;&lt;br&gt;• ทดสอบหน้าดูผลจริงใน &lt;b&gt;App / View runtime&lt;/b&gt; ที่รองรับ ListView&lt;br&gt;• 🔴 &lt;b&gt;ห้ามใช้ Form Manage CRUD เป็นหลักฐานว่า ListView เสีย&lt;/b&gt;&lt;br&gt;• 🔴 ยังห้ามกล่าวว่า App runtime ใช้งานได้จนกว่าจะทดสอบจริง" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#f8cecc,#4a1f1e);strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="1">
