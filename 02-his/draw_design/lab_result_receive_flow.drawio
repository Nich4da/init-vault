  <diagram id="labres-flow" name="Receive Flow">
    <mxGraphModel dx="1030" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2000" pageHeight="2000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="labres-flow-n1" value="Flow รับผลจาก Agent — ขั้นตอนไหนเขียนลงฟอร์มไหน" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=light-dark(#1a1a1a,#f0f0f0);" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n2" value="คอลัมน์กลาง = Process ที่ต้องเขียน (เดินบนลงล่าง) · คอลัมน์ขวา = 3 ฟอร์มที่ถูกเขียน · เส้นประ = “เขียนลง” ไม่ใช่ลำดับเวลา" style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=light-dark(#777777,#999999);" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1920" height="20" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n3" value="Agent / LISconnect" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="340" height="1610" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n4" value="HIS · Process (ต้องเขียน)" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="620" height="1610" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n5" value="HIS · ข้อมูลที่ถูกเขียน (3 ฟอร์ม)" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="600" height="1610" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n6" value="จอผู้ใช้" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=none;strokeColor=light-dark(#000000,#ffffff);fontSize=12;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="1600" y="100" width="340" height="1610" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n7" value="&lt;b&gt;1 · Agent ส่ง Result callback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ผลของใบสั่งเดียวกันอาจมาหลายครั้ง และอาจ retry ส่งซ้ำ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n3">
          <mxGeometry x="30" y="70" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n8" value="&lt;b&gt;2 · Process hl7_result_upsert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ตรวจ schema และชนิดข้อมูล · Agent เรียก &lt;b&gt;Process&lt;/b&gt; ไม่ได้เขียน ListView ตรง&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="50" y="70" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n9" value="&lt;b&gt;เคยรับ result_uid นี้แล้ว?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#fff2cc,#4a3d13);strokeColor=light-dark(#d6b656,#d6b656);align=center;verticalAlign=middle;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="35" y="200" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n10" value="&lt;b&gt;คืน duplicate แบบ idempotent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ไม่สร้าง receipt / report / item ซ้ำ · ส่งซ้ำต้องได้ผลเดิม&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#f8cecc,#4a1f1e);strokeColor=light-dark(#b85450,#b85450);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="350" y="205" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n11" value="&lt;b&gt;3 · สร้าง Technical Receipt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;สร้างก่อน materialize ผล เพื่อให้ข้อความที่พังยังมีที่เก็บ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="50" y="360" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n12" value="&lt;b&gt;4 · จับคู่ Order&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ใช้ร่วมกัน &lt;b&gt;order_no + filler_order_no + visit_id&lt;/b&gt;&lt;br&gt;🔴 ห้ามจับคู่ด้วย HN หรือ LAB NO. เพียงค่าเดียว — HN/VN ใช้แสดงบริบท ไม่ใช่ parent key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="50" y="500" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n13" value="&lt;b&gt;จับคู่ Lab Work Item ได้?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#fff2cc,#4a3d13);strokeColor=light-dark(#d6b656,#d6b656);align=center;verticalAlign=middle;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="35" y="655" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n14" value="&lt;b&gt;receipt = unmatched / error&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;เก็บ raw message + error reason ไว้ตรวจย้อนหลัง · &lt;b&gt;ห้ามทิ้งข้อความ&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#f8cecc,#4a1f1e);strokeColor=light-dark(#b85450,#b85450);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="350" y="665" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n15" value="&lt;b&gt;5 · ค้นหรือสร้าง Result Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ต้อง idempotent — ใบเดิมต้องไม่ได้รายงานใหม่ซ้ำ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="50" y="820" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n16" value="&lt;b&gt;6 · แตก items[] ของ Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;จับ Result Definition / Result Item ด้วย &lt;b&gt;obs_code = his_code_id&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="50" y="940" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n17" value="&lt;b&gt;7 · Upsert Lab_Result_Item เดิม&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ไม่สร้างซ้ำ · เก็บ result, unit, ref range, critical และ source snapshot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="50" y="1075" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n18" value="&lt;b&gt;8 · คำนวณสถานะรายงานใหม่&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;append-only ห้ามทับของเดิม&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="50" y="1220" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n19" value="&lt;b&gt;overall_status ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#fff2cc,#4a3d13);strokeColor=light-dark(#d6b656,#d6b656);align=center;verticalAlign=middle;" vertex="1" parent="labres-flow-n4">
          <mxGeometry x="35" y="1325" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n20" value="&lt;b&gt;① Lab_Result_Inbound_Receive&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1 record ต่อ &lt;b&gt;result_uid&lt;/b&gt; · &lt;b&gt;ไม่ Join Parent&lt;/b&gt;&lt;br&gt;raw payload · schema version · channel · receipt status · error&lt;br&gt;= internal / read-only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n5">
          <mxGeometry x="30" y="340" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n21" value="&lt;b&gt;② Result_Report_Manual_Entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;หัวรายงานของผลหนึ่งชุด · ผูก Lab Work Item / Order Status&lt;br&gt;&lt;b&gt;source_mode = manual | lis | mixed&lt;/b&gt;&lt;br&gt;⚠️ report_seq / stage ต้อง append-only — ห้ามเดา compound key ก่อนตรวจ API/DB จริง&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n5">
          <mxGeometry x="30" y="800" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n22" value="&lt;b&gt;③ Lab_Result_Item&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1 record ต่อ result component&lt;br&gt;ลูกของ Result Report&lt;br&gt;upsert ด้วย stable key (report + result definition หรือ source result key)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n5">
          <mxGeometry x="30" y="1060" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n23" value="&lt;b&gt;in_progress → ออกผลบางส่วน&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;รายการที่ยังไม่ออกต้องแสดง &lt;b&gt;pending&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n6">
          <mxGeometry x="30" y="1320" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n24" value="&lt;b&gt;resulted → ออกผลครบ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;stamp เวลาตามกติกา&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n6">
          <mxGeometry x="30" y="1425" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n25" value="&lt;b&gt;หน้าดูผล (ListView)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ListView อ่านจาก &lt;b&gt;Lab_Result_Item&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="labres-flow-n6">
          <mxGeometry x="30" y="1515" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="labres-flow-n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="labres-flow-n7" target="labres-flow-n8">
          <mxGeometry relative="1" as="geometry" />
