<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.7" type="device">
  <diagram id="labres-why" name="ทำไมต้อง 3 ฟอร์ม">
    <mxGraphModel dx="1030" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="labres-why-n1" value="ทำไมต้อง 3 ฟอร์ม — ไม่ใช่ 3 หน้าจอ แต่เป็น 3 ชั้นข้อมูลที่มีอายุและเจ้าของต่างกัน" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=light-dark(#1a1a1a,#f0f0f0);" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n2" value="เอกสาร result_lab.md · 25 ส.ค. 2569 · Draw.io ของ LIS ไม่ได้บังคับจำนวนฟอร์ม — การแยก 3 ชั้นเป็นการออกแบบ persistence ฝั่ง HIS เอง" style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=light-dark(#777777,#999999);" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1920" height="20" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n3" value="หนึ่งข้อความจาก Agent เดินผ่าน 3 ชั้น — แต่ละชั้นตอบคำถามคนละข้อ" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n4" value="&lt;b&gt;ข้อความจาก Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1 callback = 1 &lt;b&gt;result_uid&lt;/b&gt;&lt;br&gt;&lt;br&gt;ผลของใบสั่งเดียวกันมาได้ &lt;b&gt;หลายครั้ง&lt;/b&gt; — preliminary → final → corrected · และอาจถูก retry ส่งซ้ำใบเดิม&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="280" height="210" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n5" value="&lt;b&gt;① Lab_Result_Inbound_Receive&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;ชั้นข้อความ&lt;/b&gt; — “ใบเสร็จรับของ” ทางเทคนิค&lt;br&gt;1 record ต่อ &lt;b&gt;result_uid&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;ไม่ Join Parent&lt;/b&gt; — จึงเก็บข้อความที่ unmatched / duplicate / error ได้&lt;br&gt;&lt;br&gt;raw payload · schema version · channel · receipt status · error message&lt;br&gt;= internal / read-only ห้ามเปิดให้ผู้ใช้แก้&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n6" value="&lt;b&gt;② Result_Report_Manual_Entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;ชั้นรายงาน&lt;/b&gt; — หัวรายงานของผล “หนึ่งชุด”&lt;br&gt;ผูกกับ Lab Work Item / LAB NO.&lt;br&gt;&lt;br&gt;ถือสถานะรวม &lt;b&gt;overall_status&lt;/b&gt;&lt;br&gt;in_progress = ออกผลบางส่วน · resulted = ครบ&lt;br&gt;&lt;br&gt;&lt;b&gt;source_mode = manual | lis | mixed&lt;/b&gt;&lt;br&gt;→ ทำให้ Manual กับ LIS ใช้หัวเดียวกันได้&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n7" value="&lt;b&gt;③ Lab_Result_Item&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;ชั้นผลรายรายการ&lt;/b&gt; — 1 record ต่อ result component (ราย test / OBS)&lt;br&gt;&lt;br&gt;ลูกของ Result Report&lt;br&gt;จับรายการด้วย &lt;b&gt;obs_code = his_code_id&lt;/b&gt;&lt;br&gt;&lt;br&gt;value · unit · ref range · critical · obx_status · result_version — ทุกค่าเป็นของ “ราย item” ไม่ใช่ของรายงาน&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#e1d5e7,#33254a);strokeColor=light-dark(#9673a6,#9673a6);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="150" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n8" value="&lt;b&gt;หน้าดูผล (ListView)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;อ่านข้อมูลจาก &lt;b&gt;Lab_Result_Item&lt;/b&gt;&lt;br&gt;&lt;br&gt;ผล LIS และ Manual มาโผล่ที่เดียวกัน เพราะใช้ ② + ③ ชุดเดียวกัน&lt;br&gt;&lt;br&gt;⚠️ ต้องทดสอบใน App/View runtime จริง — Form Manage CRUD ไม่แสดง list-ui&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1600" y="150" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n9" value="callback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);" edge="1" parent="1" source="labres-why-n4" target="labres-why-n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n10" value="N ข้อความ : 1 รายงาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);" edge="1" parent="1" source="labres-why-n5" target="labres-why-n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n11" value="1 รายงาน : N ผล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);" edge="1" parent="1" source="labres-why-n6" target="labres-why-n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n12" value="แสดงผล" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;fontColor=light-dark(#333333,#e0e0e0);strokeColor=light-dark(#555555,#b9c2cd);labelBackgroundColor=light-dark(#ffffff,#121212);" edge="1" parent="1" source="labres-why-n7" target="labres-why-n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n13" value="&lt;i&gt;เทียบของจริง: “กล่องจดหมายขาเข้า” — ได้อะไรมาบ้าง&lt;/i&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="400" y="366" width="320" height="18" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n14" value="&lt;i&gt;เทียบของจริง: “ใบรายงานผล” — ใบนี้ของใคร เสร็จหรือยัง&lt;/i&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="800" y="366" width="320" height="18" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n15" value="&lt;i&gt;เทียบของจริง: “บรรทัดผลในใบ” — ค่าแต่ละตัวเป็นเท่าไร&lt;/i&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="1200" y="366" width="320" height="18" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n16" value="ทำไมยุบให้เหลือฟอร์มเดียวไม่ได้ — 3 เหตุผลที่แยกกันจริง ๆ" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n17" value="&lt;b&gt;ยุบ ① เข้า ② ไม่ได้ — ข้อความที่ยังจับคู่ไม่ได้จะไม่มีที่อยู่&lt;/b&gt;&lt;br&gt;&lt;br&gt;② ต้องผูกกับ Lab Work Item เสมอ ถ้ามีแต่ ② ข้อความที่ &lt;b&gt;จับคู่ใบสั่งไม่สำเร็จ&lt;/b&gt; จะต้องถูกทิ้ง&lt;br&gt;→ สืบย้อนไม่ได้ว่าเคยได้รับผลนั้นมาแล้ว&lt;br&gt;&lt;br&gt;🔴 idempotency key &lt;b&gt;result_uid&lt;/b&gt; ต้องอยู่ชั้นนี้ ก่อน materialize ผล — ส่งซ้ำต้องได้ duplicate ไม่ใช่ข้อมูลซ้ำ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;dashed=1;spacingLeft=8;spacingRight=8;spacingTop=6;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="600" height="175" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n18" value="&lt;b&gt;ยุบ ② ทิ้งไม่ได้ — ต้องมีหัวให้ผลหลายตัวเกาะ&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 Lab Work Item / LAB NO. = 1 รายงานที่มีหลาย test&lt;br&gt;สถานะรวม &lt;b&gt;in_progress / resulted&lt;/b&gt; เป็นของรายงาน ไม่ใช่ของ item เดี่ยว ๆ&lt;br&gt;&lt;br&gt;&lt;b&gt;source_mode&lt;/b&gt; อยู่ชั้นนี้ — เป็นจุดเดียวที่ทำให้ Manual Result กับผล LIS ไหลลงโครงเดียวกันและรวมกันในหน้าดูผลได้" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;dashed=1;spacingLeft=8;spacingRight=8;spacingTop=6;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#d6b656,#d6b656);" vertex="1" parent="1">
          <mxGeometry x="700" y="460" width="600" height="175" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n19" value="&lt;b&gt;ยุบ ③ เข้า ② ไม่ได้ — ผลเป็น “รายการ” ไม่ใช่ “คอลัมน์”&lt;/b&gt;&lt;br&gt;&lt;br&gt;จำนวน test ต่อรายงาน&lt;b&gt;ไม่คงที่&lt;/b&gt; ยัดเป็นคอลัมน์ในหัวรายงานไม่ได้&lt;br&gt;&lt;br&gt;ต้อง upsert ราย item ด้วย stable key (report + result definition หรือ source result key) เพื่อให้ผลรอบที่สองอัปเดตแถวเดิม&lt;br&gt;🔴 ไม่ใช่สร้างแถวใหม่ทุกครั้งที่ callback มา" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;dashed=1;spacingLeft=8;spacingRight=8;spacingTop=6;fontColor=light-dark(#333333,#e0e0e0);fillColor=none;strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="1">
          <mxGeometry x="1360" y="460" width="600" height="175" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n20" value="ไม่ใช่ 5 ฟอร์ม — ไฟล์ JSON บางไฟล์เป็นแค่ “หน้าตา” ของฟอร์มเดิม" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n21" value="&lt;b&gt;Lab_Result_Inbound_Receive_User_View_EMR_Person_v2.json&lt;/b&gt;&lt;br&gt;→ import ให้ฟอร์ม &lt;b&gt;Lab_Result_Inbound_Receive&lt;/b&gt;&lt;br&gt;เป็นหน้า &lt;b&gt;ดู&lt;/b&gt; receipt + รายการผล — &lt;b&gt;ไม่ใช่ endpoint รับข้อมูล&lt;/b&gt;&lt;br&gt;ListView ข้างในอ่านจาก Lab_Result_Item" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);" vertex="1" parent="1">
          <mxGeometry x="40" y="715" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n22" value="&lt;b&gt;Lab_Result_Item_Minimal_Widget_Critical.json&lt;/b&gt;&lt;br&gt;→ import ให้ฟอร์ม &lt;b&gt;Lab_Result_Item&lt;/b&gt;&lt;br&gt;&lt;br&gt;JSON UI = หน้าตา/schema ของฟอร์มเดิม ไม่ได้นับเป็นฟอร์มเพิ่ม" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#dae8fc,#16334d);strokeColor=light-dark(#6c8ebf,#6c8ebf);" vertex="1" parent="1">
          <mxGeometry x="700" y="715" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n23" value="&lt;b&gt;🔴 ห้าม import ไฟล์ …_User_View_EMR_Person_v2.json ทับ Lab_Result_Item&lt;/b&gt;&lt;br&gt;ListView ในไฟล์นี้ชี้ไปที่ &lt;b&gt;Form ID ของ Lab_Result_Item&lt;/b&gt; อยู่แล้ว&lt;br&gt;import ทับ = ฟอร์มอ้างรายการ&lt;b&gt;กลับมาหาตัวเอง&lt;/b&gt; (loop)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#f8cecc,#4a1f1e);strokeColor=light-dark(#b85450,#b85450);" vertex="1" parent="1">
          <mxGeometry x="1360" y="715" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n24" value="Draw.io ของ LIS ยืนยันอะไร และไม่ได้บอกอะไร" style="rounded=0;html=1;fillColor=light-dark(#647687,#2f3b47);strokeColor=light-dark(#314354,#46586a);fontColor=light-dark(#ffffff,#dfe6ee);fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="845" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n25" value="&lt;b&gt;✅ Draw.io ยืนยันแล้ว&lt;/b&gt;&lt;br&gt;• Agent callback เข้า HIS ผ่าน &lt;b&gt;hl7_result_upsert&lt;/b&gt;&lt;br&gt;• กันข้อความซ้ำด้วย &lt;b&gt;result_uid&lt;/b&gt;&lt;br&gt;• จับคู่ด้วย &lt;b&gt;order_no + filler_order_no + visit_id&lt;/b&gt;&lt;br&gt;• &lt;b&gt;filler_order_no&lt;/b&gt; คือ LAB NO. ที่ HIS ส่งออกไปในชื่อ &lt;b&gt;labno&lt;/b&gt;&lt;br&gt;• Result Item จับด้วย &lt;b&gt;items[].obs_code = his_code_id&lt;/b&gt; (ตาม checkpoint ปัจจุบัน)&lt;br&gt;• เก็บ receipt / version แบบ &lt;b&gt;append-only&lt;/b&gt;&lt;br&gt;• in_progress = ผลบางส่วน · resulted = ผลครบ&lt;br&gt;• critical: HIS &lt;b&gt;เก็บและแสดง&lt;/b&gt; โดยไม่คำนวณ threshold ซ้ำ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#d5e8d4,#1e3a1c);strokeColor=light-dark(#82b366,#82b366);" vertex="1" parent="1">
          <mxGeometry x="40" y="895" width="940" height="195" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n26" value="&lt;b&gt;❓ Draw.io ไม่ได้บอก&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ไม่ระบุชื่อฟอร์ม&lt;/b&gt; และ &lt;b&gt;ไม่บังคับว่าต้องมี 3 ฟอร์ม&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;สรุปคำตอบของคำถาม “ทำไม 3 ฟอร์ม”&lt;/b&gt;&lt;br&gt;โครง 3 ฟอร์ม &lt;b&gt;สอดคล้อง&lt;/b&gt;กับ flow ใน Draw.io — แต่ &lt;b&gt;ไม่ได้คัดจำนวนฟอร์มมาจาก Draw.io โดยตรง&lt;/b&gt;&lt;br&gt;เป็นการออกแบบ persistence ฝั่ง HIS เพื่อรองรับ 4 อย่าง:&lt;br&gt;&amp;nbsp;&amp;nbsp;① idempotency &amp;nbsp;② audit ย้อนหลัง&lt;br&gt;&amp;nbsp;&amp;nbsp;③ รายงาน 1 ชุดที่มีหลายผล &amp;nbsp;④ ใช้โครงเดียวกันร่วมกับ Manual Result" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontColor=light-dark(#333333,#e0e0e0);fillColor=light-dark(#fff2cc,#4a3d13);strokeColor=light-dark(#d6b656,#d6b656);" vertex="1" parent="1">
          <mxGeometry x="1020" y="895" width="940" height="195" as="geometry" />
        </mxCell>
        <mxCell id="labres-why-n27" value="LEGEND" style="rounded=0;html=1;fillColor=light-dark(#fafafa,#1c1c1c);strokeColor=light-dark(#8a8a8a,#9aa3ad);verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=light-dark(#333333,#e0e0e0);" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1600" height="112" as="geometry" />
        </mxCell>
